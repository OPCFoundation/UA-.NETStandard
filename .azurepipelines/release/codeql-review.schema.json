{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opcfoundation.org/schemas/ua-netstandard/codeql-review-v1.schema.json",
  "title": "Independent signed CodeQL disposition, created before release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "kind", "repository", "sourceRef", "producer", "review",
    "policyDigest", "checkpointSequence", "issuedAt", "expiresAt", "recordReferences"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "kind": { "const": "codeql-disposition" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourceRef": { "type": "string", "pattern": "^refs/heads/(master|release/2\\.[A-Za-z0-9._/-]+)$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "workflow", "definitionSha", "runId", "attempt", "job", "tools"],
      "properties": {
        "system": { "const": "github-actions" },
        "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$" },
        "definitionSha": { "$ref": "#/$defs/sha" },
        "runId": { "$ref": "#/$defs/numberId" },
        "attempt": { "type": "integer", "minimum": 1 },
        "job": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "tools": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha", "runId", "attempt", "analysisId", "queryDigest", "populationDigest",
        "reviewedOccurrences", "reviewedAlerts", "unresolvedFindings"
      ],
      "properties": {
        "sourceSha": { "$ref": "#/$defs/sha" },
        "runId": { "$ref": "#/$defs/numberId" },
        "attempt": { "type": "integer", "minimum": 1 },
        "analysisId": { "$ref": "#/$defs/numberId" },
        "queryDigest": { "$ref": "#/$defs/digest" },
        "populationDigest": { "$ref": "#/$defs/digest" },
        "reviewedOccurrences": { "type": "integer", "minimum": 1 },
        "reviewedAlerts": { "type": "integer", "minimum": 1 },
        "unresolvedFindings": { "type": "integer", "minimum": 0 }
      }
    },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "checkpointSequence": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "recordReferences": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^record:[a-z0-9][a-z0-9-]{0,63}$" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "numberId": { "type": "string", "pattern": "^[1-9][0-9]*$" }
  }
}
