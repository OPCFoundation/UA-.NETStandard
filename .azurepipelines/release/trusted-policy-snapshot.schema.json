{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opcfoundation.org/schemas/ua-netstandard/trusted-policy-snapshot-v1.schema.json",
  "title": "Externally anchored protected policy snapshot; never trusted by file name or self-declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "authority", "stage", "checkpointSequence", "issuedAt", "expiresAt",
    "policyDigest", "contractFiles", "expectedRelease", "expectedIntentDigest",
    "authorities", "producers", "revokedRecordIds", "tool", "trustedRoot"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authority": { "$ref": "#/$defs/text" },
    "stage": { "enum": ["pilot", "required"] },
    "checkpointSequence": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "contractFiles": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "verification-record.schema.json#/$defs/frozenFile" }
    },
    "expectedRelease": { "$ref": "evidence.schema.json#/properties/release" },
    "expectedIntentDigest": { "$ref": "#/$defs/digest" },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "repository", "issuer", "certificateIdentity", "workflow", "definitionSha", "ref", "recordKinds"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "repository": { "$ref": "#/$defs/text" },
          "issuer": { "type": "string", "format": "uri" },
          "certificateIdentity": { "$ref": "#/$defs/text" },
          "workflow": { "$ref": "verification-bundle.schema.json#/$defs/path" },
          "definitionSha": { "$ref": "evidence.schema.json#/$defs/sha" },
          "ref": { "$ref": "#/$defs/text" },
          "recordKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "anyOf": [
                { "$ref": "verification-record.schema.json#/properties/kind" },
                { "enum": ["native-nuget-index", "native-nuget-pack"] }
              ]
            }
          }
        }
      }
    },
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "workflow", "definitionSha", "jobs", "tools"],
        "properties": {
          "system": { "enum": ["github-actions", "azure-pipelines"] },
          "workflow": { "$ref": "verification-bundle.schema.json#/$defs/path" },
          "definitionSha": { "$ref": "evidence.schema.json#/$defs/sha" },
          "jobs": { "$ref": "verification-record.schema.json#/$defs/strings" },
          "tools": { "$ref": "evidence.schema.json#/$defs/producer/properties/tools" }
        }
      }
    },
    "revokedRecordIds": { "$ref": "verification-record.schema.json#/$defs/strings" },
    "tool": { "$ref": "#/$defs/toolPin" },
    "trustedRoot": { "$ref": "#/$defs/toolPin" },
    "nugetVerifier": { "$ref": "#/$defs/toolPin" },
    "cosignVerifier": { "$ref": "#/$defs/toolPin" },
    "nugetAuthorFingerprints": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "toolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "version"],
      "properties": {
        "path": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" },
        "version": { "$ref": "#/$defs/text" }
      }
    }
  }
}
