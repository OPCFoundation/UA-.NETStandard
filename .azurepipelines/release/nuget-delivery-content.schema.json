{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opcfoundation.org/schemas/release-evidence/nuget-delivery-content-v1.json",
  "title": "NuGet author-to-delivered content comparison, not signature authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "packageId", "version",
    "authorArchiveDigest", "deliveredArchiveDigest", "authorContentDigest", "deliveredContentDigest",
    "contentPreserved", "authorSignaturePreserved", "signatureVerificationPerformed",
    "content", "unmetControls", "findings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["content-matched", "content-mismatch"] },
    "packageId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "minLength": 1 },
    "authorArchiveDigest": { "$ref": "#/$defs/digest" },
    "deliveredArchiveDigest": { "$ref": "#/$defs/digest" },
    "authorContentDigest": { "$ref": "#/$defs/digest" },
    "deliveredContentDigest": { "$ref": "#/$defs/digest" },
    "contentPreserved": { "type": "boolean" },
    "authorSignaturePreserved": { "type": "boolean" },
    "signatureVerificationPerformed": { "const": false },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0, "maximum": 268435456 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "unmetControls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "SIGNATURE_VERIFIED" },
      "items": { "enum": ["ARTIFACT_INTEGRITY", "SIGNATURE_VERIFIED"] }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": { "enum": ["ARTIFACT_INTEGRITY", "SIGNATURE_VERIFIED"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "content-matched" } } },
      "then": {
        "properties": {
          "contentPreserved": { "const": true },
          "authorSignaturePreserved": { "const": true }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
