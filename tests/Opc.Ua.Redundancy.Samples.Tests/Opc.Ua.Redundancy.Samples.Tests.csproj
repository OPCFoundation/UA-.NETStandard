<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      These are process-level integration tests that launch the RedundantServer,
      RedundantClient and RedundantPubSub sample applications and assert on
      their high-availability log output. The samples are .NET 8+ only and
      follow CustomTestTarget, so the tests do too: a net8.0 / net9.0 / net10.0
      profile builds and runs them on that framework. On the legacy profiles
      (net48, net472, netstandard2.0, netstandard2.1) the samples are empty
      RestrictForLegacyTfm shells, so RestrictForLegacyTfm makes this project
      an explicit not-applicable shell there as well.

      Without CustomTestTarget the project also exposes a net48 placeholder
      target with no test code, so the Azure DevOps leg that invokes
      `dotnet test -f net48` without CustomTestTarget finds a runnable target.
    -->
    <TargetFrameworks Condition="'$(CustomTestTarget)' == ''">net48;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CustomTestTarget)' != ''">$(CustomTestTarget)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <_SamplesPlaceholder Condition="'$(TargetFramework)' == 'net48'">true</_SamplesPlaceholder>
    <EnableDefaultCompileItems Condition="'$(_SamplesPlaceholder)' == 'true'">false</EnableDefaultCompileItems>
    <RootNamespace>Opc.Ua.Redundancy.Samples.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      The placeholder assembly (legacy TFM matrix entries) has no source code;
      suppress CA1014 (assembly-level CLSCompliant) for that build only.
    -->
    <NoWarn Condition="'$(_SamplesPlaceholder)' == 'true'">$(NoWarn);CA1014</NoWarn>
    <!--
      Common test-project suppression list (matches the rest of tests/*/*.csproj).
      Test code is allowed to be noisier on these analyzer rules.
    -->
    <NoWarn>$(NoWarn);RCS0056;RCS1166;RCS1174;RCS1229;RCS1047;RCS1077;NUnit2023;NUnit2010;NUnit2045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(_SamplesPlaceholder)' == 'true'">
    <Compile Include="PlaceholderTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(_SamplesPlaceholder)' != 'true'">
    <Compile Remove="PlaceholderTests.cs" />
  </ItemGroup>

  <!--
    Reference the sample applications so they are built alongside these tests and
    can be located and launched at runtime. ReferenceOutputAssembly is false
    because the tests launch the apps as external processes rather than calling
    into their assemblies directly.
  -->
  <ItemGroup Condition="'$(_SamplesPlaceholder)' != 'true'">
    <ProjectReference Include="..\..\samples\Redundancy\RedundantServer\RedundantServer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\Redundancy\RedundantClient\RedundantClient.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\samples\Redundancy\RedundantPubSub\RedundantPubSub.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
