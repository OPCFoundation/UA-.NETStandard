<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Opc.Ua.Server.Tests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- The coverage NodeSet models are consumed in-process by the coverage
         test harness, which asserts the published NamespaceMetadata carries the
         model version/publication date. The generator only emits the
         [assembly: ModelDependency] self-declaration for library outputs by
         default; force it on so the test executable also carries it. -->
    <ModelSourceGeneratorEmitDependencyMetadata>true</ModelSourceGeneratorEmitDependencyMetadata>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Console" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Common\Main.cs" />
    <Compile Include="..\Common\NodeStateMemoryEvidence.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\samples\AsyncServices\RecoverableServiceDemo\RecoverableServiceDemo.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="AsyncServices\RecoverableServiceDemoTests.cs" />
  </ItemGroup>
  <!--
    The sample child has its own deps/runtimeconfig and must not depend on the
    test host's additional shared frameworks or pruned copy-local closure.
    Query output metadata only, even when BuildProjectReferences=false. This
    AfterBuild target does not run for no-build tests or design-time checks.
  -->
  <Target Name="StageRecoverableServiceDemoChildHost"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' == 'net10.0' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_RseSampleProject Include="@(ProjectReference)"
                         Condition="'%(ProjectReference.Filename)' == 'RecoverableServiceDemo'" />
    </ItemGroup>
    <Error Condition="'@(_RseSampleProject->Count())' != '1'"
           Text="The net10 restart binding requires exactly one RecoverableServiceDemo project reference." />
    <MSBuild Projects="@(_RseSampleProject)"
             Targets="GetTargetPath"
             BuildInParallel="false"
             RemoveProperties="TargetFrameworks;RuntimeIdentifier;SelfContained;OutDir;OutputPath;BaseOutputPath;BaseIntermediateOutputPath;IntermediateOutputPath"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;BuildProjectReferences=false">
      <Output TaskParameter="TargetOutputs" ItemName="_RseSampleTarget" />
    </MSBuild>
    <Error Condition="'@(_RseSampleTarget->Count())' != '1'"
           Text="Could not resolve the existing net10 RecoverableServiceDemo output through GetTargetPath." />
    <PropertyGroup>
      <_RseSampleOutputDirectory>@(_RseSampleTarget->'%(RootDir)%(Directory)')</_RseSampleOutputDirectory>
      <_RseSampleHostName>@(_RseSampleTarget->'%(Filename)')</_RseSampleHostName>
      <_RseChildHostDirectory>$(TargetDir)rse-process-host\</_RseChildHostDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('@(_RseSampleTarget)') or !Exists('$(_RseSampleOutputDirectory)$(_RseSampleHostName).deps.json') or !Exists('$(_RseSampleOutputDirectory)$(_RseSampleHostName).runtimeconfig.json')"
           Text="Build RecoverableServiceDemo net10.0 $(Configuration) before staging its child host. The existing assembly, deps and runtimeconfig are required; this target never builds project references." />
    <Error Condition="'$(OS)' == 'Windows_NT' and !Exists('$(_RseSampleOutputDirectory)$(_RseSampleHostName).exe')"
           Text="The Windows restart binding requires the already-built RecoverableServiceDemo apphost." />
    <ItemGroup>
      <_RseChildPrivateMaterial Include="$(_RseSampleOutputDirectory)**\*.pfx;$(_RseSampleOutputDirectory)**\*.p12;$(_RseSampleOutputDirectory)**\*.pem;$(_RseSampleOutputDirectory)**\*.key;$(_RseSampleOutputDirectory)**\*.cer;$(_RseSampleOutputDirectory)**\*.crt;$(_RseSampleOutputDirectory)**\*.crl;$(_RseSampleOutputDirectory)**\pki\**\*;$(_RseSampleOutputDirectory)**\private\**\*" />
      <_RseChildRuntimeFiles Include="$(_RseSampleOutputDirectory)**\*" />
    </ItemGroup>
    <Error Condition="'@(_RseChildPrivateMaterial)' != ''"
           Text="The sample runtime output contains key/certificate/PKI material and cannot be staged as a child host. Runtime credentials must remain in run-owned temporary storage." />
    <!-- This dedicated build-output directory is owned solely by this target. -->
    <RemoveDir Directories="$(_RseChildHostDirectory)" />
    <MakeDir Directories="$(_RseChildHostDirectory)" />
    <Copy SourceFiles="@(_RseChildRuntimeFiles)"
          DestinationFiles="@(_RseChildRuntimeFiles->'$(_RseChildHostDirectory)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high"
             Text="Staged @(_RseChildRuntimeFiles->Count()) sample runtime files from $(_RseSampleOutputDirectory) to $(_RseChildHostDirectory)" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="ComplexTypes\ServerComplexTypesTestModel.NodeSet2.xml">
      <LogicalName>Opc.Ua.Server.Tests.ComplexTypes.ServerComplexTypesTestModel.NodeSet2.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="CoverageNodeSet\Assets\Opc.Ua.CoverageTest.NodeSet2.xml">
      <LogicalName>Opc.Ua.Server.Tests.CoverageNodeSet.Assets.Opc.Ua.CoverageTest.NodeSet2.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="CoverageNodeSet\Assets\Opc.Ua.CoverageTestSecondary.NodeSet2.xml">
      <LogicalName>Opc.Ua.Server.Tests.CoverageNodeSet.Assets.Opc.Ua.CoverageTestSecondary.NodeSet2.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Source-generation pipeline for the kitchen-sink coverage NodeSet (issue #4251).
       The same XML is embedded above for the runtime import pipeline. -->
  <ItemGroup>
    <AdditionalFiles Include="AsyncServices\Model\AsyncExecution.xml">
      <ModelSourceGeneratorModelUri>urn:opcfoundation:tests:async-services</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>AsyncExecution</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.TestModels.AsyncExecution</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <AdditionalFiles Include="AsyncServices\Model\AsyncExecution.csv" />
    <AdditionalFiles Include="Programs\Assets\DomainDownloadModel.xml">
      <ModelSourceGeneratorModelUri>urn:opcfoundation:tests:programs</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>DomainDownloadModel</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.TestModels.DomainDownload</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <AdditionalFiles Include="Programs\Assets\DomainDownloadModel.csv" />
    <AdditionalFiles Include="CoverageNodeSet\Assets\Opc.Ua.CoverageTest.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/CoverageTest/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>CoverageTest</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.CoverageTest</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <AdditionalFiles Include="CoverageNodeSet\Assets\Opc.Ua.CoverageTest.NodeSet2.csv" />
    <AdditionalFiles Include="CoverageNodeSet\Assets\Opc.Ua.CoverageTestSecondary.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/CoverageTest/Secondary/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>CoverageTestSecondary</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.CoverageTestSecondary</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <!-- Model behind the fluent NodeSet2 import tests: the generated node
         manager supplies the typed import factories for its own model. -->
    <AdditionalFiles Include="Fluent\Assets\NodeSetImport.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>urn:opcfoundation.org:2026-09:NodeSetImport</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>NodeSetImportModel</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>NodeSetImportModel</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <!-- ModelDesign behind the inline method tests: a method that declares its
         arguments without a method type. -->
    <AdditionalFiles Include="Fluent\Assets\InlineMethod.xml">
      <ModelSourceGeneratorModelUri>urn:opcfoundation.org:2026-09:InlineMethod</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>InlineMethodModel</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>InlineMethodModel</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="test-memorybuffer-config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="test-testdata-config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\samples\Quickstarts.Servers\Quickstarts.Servers.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Redundancy.Server\Opc.Ua.Redundancy.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Lds.Server\Opc.Ua.Lds.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Gds.Server\Opc.Ua.Gds.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Bindings.Https\Opc.Ua.Bindings.Https.csproj" />
    <ProjectReference Include="..\Opc.Ua.Core.Tests\Opc.Ua.Core.Tests.csproj" />
    <ProjectReference Include="..\Opc.Ua.Server.TestFramework\Opc.Ua.Server.TestFramework.csproj" />
    <ProjectReference Include="..\Opc.Ua.Client.TestFramework\Opc.Ua.Client.TestFramework.csproj" />
    <ProjectReference Include="..\Opc.Ua.Test.Common\Opc.Ua.Test.Common.csproj" />
  </ItemGroup>
</Project>
