{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "uav": "http://opcfoundation.org/UA/WoT-Binding/",
      "ua": "http://opcfoundation.org/UA/",
      "tm": "https://www.w3.org/2019/wot/tm#"
    },
    "../opc-ua-wot-binding.context.jsonld"
  ],
  "@type": ["tm:ThingModel"],
  "id": "urn:example:model:pump-asset",
  "title": "Pump asset model",
  "description": "A type-level asset plan over the pump Thing Model. It resolves to a Thing Model and has one canonical type-level View. The four group plans retain their canonical Views and are organized through separate occurrence Objects with ProjectionRoot Properties.",
  "uav:scenario": "http://example.com/scenario/AssetManagement",
  "links": [
    {
      "rel": "ua:Organizes",
      "href": "./16-model-group-process-data.jsonld",
      "uav:refName": "ProcessData",
      "type": "application/ld+json; profile=\"http://opcfoundation.org/UA/WoT-Binding/v1.1/projection\""
    },
    {
      "rel": "ua:Organizes",
      "href": "./17-model-group-condition-data.jsonld",
      "uav:refName": "ConditionData",
      "type": "application/ld+json; profile=\"http://opcfoundation.org/UA/WoT-Binding/v1.1/projection\""
    },
    {
      "rel": "ua:Organizes",
      "href": "./18-model-group-alarms.jsonld",
      "uav:refName": "Alarms",
      "type": "application/ld+json; profile=\"http://opcfoundation.org/UA/WoT-Binding/v1.1/projection\""
    },
    {
      "rel": "ua:Organizes",
      "href": "./19-model-group-management.jsonld",
      "uav:refName": "Management",
      "type": "application/ld+json; profile=\"http://opcfoundation.org/UA/WoT-Binding/v1.1/projection\""
    }
  ],
  "properties": {
    "serialNumber": {
      "@context": [{
        "@base": "./02-thing-model-pump.jsonld",
        "@language": "en",
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Serial Number",
      "uav:browseName": "pump:SerialNumber",
      "type": "string",
      "uav:modellingRule": "Mandatory",
      "uav:resolvedFrom": "./02-thing-model-pump.jsonld#/properties/serialNumber"
    }
  }
}
