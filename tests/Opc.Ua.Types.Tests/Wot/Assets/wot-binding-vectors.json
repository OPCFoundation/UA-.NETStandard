          ]
        }
      ]
    },
    "viewVersion": {
      "clause": "sec-materialization-to-an-opc-ua-view",
      "description": "Section 12.6. Persisted positive UInt32 publication token: a fresh View starts at 1; only a committed change of semantic membership advances the token, skipping zero on wrap. Force does not advance unchanged membership. Uncommitted work retains the prior publication. Membership fingerprints are separate full SHA-256 values.",
      "cases": [
        {
          "id": "three-members",
          "members": [
            "nsu=http://example.com/demo/pump;s=Pump",
            "nsu=http://example.com/demo/pump;s=Pump.PumpSpeed",
            "i=85"
          ],
          "viewVersion": 1
        },
        {
          "id": "duplicates-are-removed",
          "members": [
            "nsu=http://example.com/demo/pump;s=Pump",
            "nsu=http://example.com/demo/pump;s=Pump.PumpSpeed",
            "i=85",
            "nsu=http://example.com/demo/pump;s=Pump"
          ],
          "previousMembers": ["nsu=http://example.com/demo/pump;s=Pump", "nsu=http://example.com/demo/pump;s=Pump.PumpSpeed", "i=85"],
          "previousVersion": 7,
          "viewVersion": 7
        },
        {
          "id": "input-order-does-not-matter",
          "members": [
            "i=85",
            "nsu=http://example.com/demo/pump;s=Pump.PumpSpeed",
            "nsu=http://example.com/demo/pump;s=Pump"
          ],
          "previousMembers": ["nsu=http://example.com/demo/pump;s=Pump", "nsu=http://example.com/demo/pump;s=Pump.PumpSpeed", "i=85"],
          "previousVersion": 7,
          "viewVersion": 7
        },
        {
          "id": "single-member",
          "members": [
            "nsu=http://example.com/demo/pump;s=Pump"
          ],
          "viewVersion": 1
        },
        {
          "id": "old-hash-collision-still-changes-token",
          "previousMembers": ["nsu=urn:example;s=Member1727"],
          "previousVersion": 1,
          "members": ["nsu=urn:example;s=Member33300"],
          "viewVersion": 2
        },
        {
          "id": "force-identical-membership",
          "previousMembers": ["nsu=urn:example;i=1"],
          "previousVersion": 9,
          "members": ["nsu=urn%3Aexample;i=01", "nsu=urn:example;i=1"],
          "force": true,
          "viewVersion": 9
        },
        {
          "id": "uncommitted-membership-change",
          "previousMembers": ["nsu=urn:example;s=Member1727"],
          "previousVersion": 4,
          "members": ["nsu=urn:example;s=Member33300"],
          "committed": false,
          "viewVersion": 4
        },
        {
          "id": "wrap-skips-zero",
          "previousMembers": ["nsu=urn:example;s=Member1727"],
          "previousVersion": 4294967295,
          "members": ["nsu=urn:example;s=Member33300"],
          "viewVersion": 1
        },
        {
          "id": "fresh-empty-view",
          "members": [],
          "viewVersion": 1
        },
        {
          "id": "uncommitted-first-view",
          "members": ["i=85"],
          "committed": false,
          "viewVersion": null
        }
      ]
    },
