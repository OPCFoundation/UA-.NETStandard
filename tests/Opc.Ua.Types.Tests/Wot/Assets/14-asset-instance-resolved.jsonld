{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "uav": "http://opcfoundation.org/UA/WoT-Binding/",
      "ua": "http://opcfoundation.org/UA/",
      "tm": "https://www.w3.org/2019/wot/tm#"
    },
    "../opc-ua-wot-binding.context.jsonld"
  ],
  "@type": ["Thing"],
  "id": "urn:dev:opcua:asset:pump-01",
  "title": "Pump 01 asset",
  "description": "An asset view combining device identity with process, condition, alarm and management groups. The groups select their affordances from the pump Thing Description without changing that source.",
  "uav:scenario": "http://example.com/scenario/AssetManagement",
  "security": ["q:p:nosec_sc"],
  "links": [
    {
      "rel": "ua:Organizes",
      "href": "./10-group-process-data.jsonld",
      "uav:refName": "ProcessData",
      "type": "application/td+json"
    },
    {
      "rel": "ua:Organizes",
      "href": "./11-group-condition-data.jsonld",
      "uav:refName": "ConditionData",
      "type": "application/td+json"
    },
    {
      "rel": "ua:Organizes",
      "href": "./12-group-alarms.jsonld",
      "uav:refName": "Alarms",
      "type": "application/td+json"
    },
    {
      "rel": "ua:Organizes",
      "href": "./13-group-management.jsonld",
      "uav:refName": "Management",
      "type": "application/td+json"
    }
  ],
  "securityDefinitions": {
    "q:p:nosec_sc": { "scheme": "nosec" },
    "q:s:identity:opcua_channel_sc": {
      "@context": [{"@base": "./06-anchored-paths-and-device-identity.jsonld", "pump": {"@id": "http://example.com/demo/pump"}}],
      "scheme": "uav:channelsec",
      "uav:securityMode": "SignAndEncrypt",
      "uav:securityPolicy": "Aes256_Sha256_RsaPss"
    }
  },
  "properties": {
    "serialNumber": {
      "@context": [{
        "@base": "./06-anchored-paths-and-device-identity.jsonld",
        "di": { "@id": "http://opcfoundation.org/UA/DI/", "@prefix": true },
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Serial Number",
      "uav:browseName": "di:SerialNumber",
      "uav:browsePath": "di:Identification/di:SerialNumber",
      "uav:browsePathAnchor": "nsu=http://example.com/demo/pump;s=Pump07",
      "type": "string",
      "readOnly": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/UA/Factory?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DPump07.SerialNumber",
          "contentType": "application/octet-stream",
          "op": ["readproperty"],
          "security": ["q:s:identity:opcua_channel_sc"]
        }
      ],
      "uav:resolvedFrom": "./06-anchored-paths-and-device-identity.jsonld#/properties/serialNumber"
    },
    "manufacturer": {
      "@context": [{
        "@base": "./06-anchored-paths-and-device-identity.jsonld",
        "di": { "@id": "http://opcfoundation.org/UA/DI/", "@prefix": true },
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Manufacturer",
      "uav:browseName": "di:Manufacturer",
      "uav:browsePath": "di:Identification/di:Manufacturer",
      "uav:browsePathAnchor": "nsu=http://example.com/demo/pump;s=Pump07",
      "type": "string",
      "readOnly": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/UA/Factory",
          "contentType": "application/octet-stream",
          "op": ["readproperty"],
          "security": ["q:s:identity:opcua_channel_sc"]
        }
      ],
      "uav:resolvedFrom": "./06-anchored-paths-and-device-identity.jsonld#/properties/manufacturer"
    },
    "manual": {
      "@context": [{
        "@base": "./06-anchored-paths-and-device-identity.jsonld",
        "di": { "@id": "http://opcfoundation.org/UA/DI/", "@prefix": true },
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Device Manual",
      "uav:browseName": "di:DeviceManual",
      "uav:browsePath": "di:Identification/di:DeviceManual",
      "uav:browsePathAnchor": "nsu=http://example.com/demo/pump;s=Pump07",
      "type": "string",
      "readOnly": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/UA/Factory?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DPump07.DeviceManual",
          "contentType": "application/octet-stream",
          "op": ["readproperty"],
          "security": ["q:s:identity:opcua_channel_sc"]
        }
      ],
      "uav:resolvedFrom": "./06-anchored-paths-and-device-identity.jsonld#/properties/manual"
    }
  }
}
