{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "uav": "http://opcfoundation.org/UA/WoT-Binding/",
      "tm": "https://www.w3.org/2019/wot/tm#"
    },
    "../opc-ua-wot-binding.context.jsonld"
  ],
  "@type": ["Thing"],
  "id": "urn:dev:opcua:view:pump-predictive-maintenance",
  "title": "Pump condition view",
  "description": "A predictive-maintenance view combining the pump's process signals with its device identity. The selected affordances retain source interaction and security definitions with maintenance annotations.",
  "uav:scenario": "http://example.com/scenario/PredictiveMaintenance",
  "securityDefinitions": {
    "q:p:nosec_sc": { "scheme": "nosec" },
    "q:s:pump:opcua_sc": {
      "@context": [{"@base": "./01-opcua-td-pump.jsonld", "pump": {"@id": "http://example.com/demo/pump"}}],
      "scheme": "combo",
      "allOf": ["q:s:pump:opcua_channel_sc", "q:s:pump:opcua_authentication_sc"]
    },
    "q:s:pump:opcua_channel_sc": {
      "@context": [{"@base": "./01-opcua-td-pump.jsonld", "pump": {"@id": "http://example.com/demo/pump"}}],
      "scheme": "uav:channelsec",
      "uav:securityMode": "SignAndEncrypt",
      "uav:securityPolicy": "Aes256_Sha256_RsaPss"
    },
    "q:s:pump:opcua_authentication_sc": {
      "@context": [{"@base": "./01-opcua-td-pump.jsonld", "pump": {"@id": "http://example.com/demo/pump"}}],
      "scheme": "uav:authentication",
      "uav:userIdentityToken": "UserName"
    },
    "q:s:identity:opcua_channel_sc": {
      "@context": [{"@base": "./06-anchored-paths-and-device-identity.jsonld", "pump": {"@id": "http://example.com/demo/pump"}}],
      "scheme": "uav:channelsec",
      "uav:securityMode": "SignAndEncrypt",
      "uav:securityPolicy": "Aes256_Sha256_RsaPss"
    }
  },
  "security": ["q:p:nosec_sc"],
  "properties": {
    "pumpSpeed": {
      "@context": [{
        "@base": "./01-opcua-td-pump.jsonld",
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Pump speed (condition signal)",
      "description": "The speed reading interpreted as a condition signal for the predictive-maintenance model.",
      "uav:semanticId": "http://example.com/ontology/maintenance/ConditionSignal",
      "uav:browseName": "pump:PumpSpeed",
      "uav:browsePath": "/Objects/pump:Pump/pump:PumpSpeed",
      "type": "number",
      "unit": "rpm",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DPumpSpeed",
          "contentType": "application/octet-stream",
          "op": ["readproperty", "observeproperty"],
          "security": ["q:s:pump:opcua_sc"]
        }
      ],
      "uav:resolvedFrom": "./01-opcua-td-pump.jsonld#/properties/pumpSpeed"
    },
    "speedSetpoint": {
      "@context": [{
        "@base": "./01-opcua-td-pump.jsonld",
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Speed Setpoint",
      "uav:browseName": "pump:SpeedSetpoint",
      "uav:browsePath": "/Objects/pump:Pump/pump:SpeedSetpoint",
      "type": "number",
      "unit": "rpm",
      "readOnly": false,
      "observable": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DSpeedSetpoint",
          "contentType": "application/octet-stream",
          "op": ["readproperty", "writeproperty", "observeproperty"],
          "security": ["q:s:pump:opcua_sc"]
        }
      ],
      "uav:resolvedFrom": "./01-opcua-td-pump.jsonld#/properties/speedSetpoint"
    },
    "dischargePressure": {
      "@context": [{
        "@base": "./01-opcua-td-pump.jsonld",
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Discharge Pressure",
      "uav:browseName": "pump:DischargePressure",
      "uav:browsePath": "/Objects/pump:Pump/pump:DischargePressure",
      "type": "number",
      "unit": "bar",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DDischargePressure",
          "contentType": "application/octet-stream",
          "op": ["readproperty", "observeproperty"],
          "security": ["q:s:pump:opcua_sc"]
        }
      ],
      "uav:resolvedFrom": "./01-opcua-td-pump.jsonld#/properties/dischargePressure"
    },
    "motorTemperature": {
      "@context": [{
        "@base": "./01-opcua-td-pump.jsonld",
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Motor Temperature",
      "uav:browseName": "pump:MotorTemperature",
      "uav:browsePath": "/Objects/pump:Pump/pump:MotorTemperature",
      "type": "number",
      "unit": "Cel",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DMotorTemperature",
          "contentType": "application/octet-stream",
          "op": ["readproperty", "observeproperty"],
          "security": ["q:s:pump:opcua_sc"]
        }
      ],
      "uav:resolvedFrom": "./01-opcua-td-pump.jsonld#/properties/motorTemperature"
    },
    "deviceSerialNumber": {
      "@context": [{
        "@base": "./06-anchored-paths-and-device-identity.jsonld",
        "di": { "@id": "http://opcfoundation.org/UA/DI/", "@prefix": true },
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Serial Number",
      "uav:browseName": "di:SerialNumber",
      "uav:browsePath": "di:Identification/di:SerialNumber",
      "uav:browsePathAnchor": "nsu=http://example.com/demo/pump;s=Pump07",
      "type": "string",
      "readOnly": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/UA/Factory?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DPump07.SerialNumber",
          "contentType": "application/octet-stream",
          "op": ["readproperty"],
          "security": ["q:s:identity:opcua_channel_sc"]
        }
      ],
      "uav:resolvedFrom": "./06-anchored-paths-and-device-identity.jsonld#/properties/serialNumber"
    },
    "deviceManufacturer": {
      "@context": [{
        "@base": "./06-anchored-paths-and-device-identity.jsonld",
        "di": { "@id": "http://opcfoundation.org/UA/DI/", "@prefix": true },
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Manufacturer",
      "uav:browseName": "di:Manufacturer",
      "uav:browsePath": "di:Identification/di:Manufacturer",
      "uav:browsePathAnchor": "nsu=http://example.com/demo/pump;s=Pump07",
      "type": "string",
      "readOnly": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/UA/Factory",
          "contentType": "application/octet-stream",
          "op": ["readproperty"],
          "security": ["q:s:identity:opcua_channel_sc"]
        }
      ],
      "uav:resolvedFrom": "./06-anchored-paths-and-device-identity.jsonld#/properties/manufacturer"
    },
    "deviceManual": {
      "@context": [{
        "@base": "./06-anchored-paths-and-device-identity.jsonld",
        "di": { "@id": "http://opcfoundation.org/UA/DI/", "@prefix": true },
        "pump": { "@id": "http://example.com/demo/pump" }
      }],
      "@type": "uav:variable",
      "title": "Device Manual",
      "uav:browseName": "di:DeviceManual",
      "uav:browsePath": "di:Identification/di:DeviceManual",
      "uav:browsePathAnchor": "nsu=http://example.com/demo/pump;s=Pump07",
      "type": "string",
      "readOnly": true,
      "forms": [
        {
          "href": "opc.tcp://opcuademo.com:4840/UA/Factory?id=nsu%3Dhttp%3A%2F%2Fexample.com%2Fdemo%2Fpump%3Bs%3DPump07.DeviceManual",
          "contentType": "application/octet-stream",
          "op": ["readproperty"],
          "security": ["q:s:identity:opcua_channel_sc"]
        }
      ],
      "uav:resolvedFrom": "./06-anchored-paths-and-device-identity.jsonld#/properties/manual"
    }
  }
}
