{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "uav": "http://opcfoundation.org/UA/WoT-Binding/",
      "tm": "https://www.w3.org/2019/wot/tm#"
    },
    "../opc-ua-wot-binding.context.jsonld"
  ],
  "@type": ["tm:ThingModel", "uav:projection"],
  "id": "urn:example:model:pump-asset:alarms",
  "title": "Alarms",
  "description": "The type-level event group. Selecting by predicate rather than by name means an event added to the pump type joins the group of every instance without the group being edited.",
  "uav:scenario": "http://example.com/scenario/AssetManagement",
  "uav:projects": [
    {
      "uav:sourceName": "pumpType",
      "href": "./02-thing-model-pump.jsonld",
      "type": "application/tm+json",
      "uav:routing": "source",
      "uav:select": [
        { "uav:affordanceKind": "event", "@type": "uav:eventType" }
      ]
    }
  ]
}
