{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "uav": "http://opcfoundation.org/UA/WoT-Binding/",
      "ua": "http://opcfoundation.org/UA/",
      "pump": "http://example.com/demo/pump",
      "@language": "en"
    },
    "../opc-ua-wot-binding.context.jsonld"
  ],
  "@type": ["tm:ThingModel", "uav:objectType"],
  "title": "PumpAlarmsType",
  "description": "A Thing Model of the ObjectType that raises the pump's alarms, carrying the two EventType definitions a Thing Description links to instead of restating one select clause per field. The first is the pump's own HighTemperatureAlarmType, stated as the complete effective field set a fast path derives its baseline selection from; the second is the ua:LimitAlarmType, which declares four limit fields and inherits the rest, and which an explicit select clause names to reach one of them.",
  "uav:bindingVersion": "1.1",
  "uav:profile": ["WoT-Modeller", "WoT-EventMapping"],
  "uav:browseName": "pump:PumpAlarmsType",
  "uav:id": "nsu=http://example.com/demo/pump;i=1005",
  "events": {
    "highTemperatureAlarm": {
      "@type": "uav:eventType",
      "title": "High Temperature Alarm",
      "description": "The EventType definition of the pump's high-temperature limit alarm. Its data schema is effective: it declares every field an affordance that links to this definition selects, the fields inherited from BaseEventType, ConditionType, AcknowledgeableConditionType, AlarmConditionType and LimitAlarmType included, and uav:fieldOrder states the order the clauses are derived in.",
      "uav:isEvent": true,
      "uav:id": "nsu=http://example.com/demo/pump;i=6001",
      "uav:browseName": "pump:HighTemperatureAlarmType",
      "uav:severity": 700,
      "data": {
        "type": "object",
        "uav:fieldOrder": [
          "EventId",
          "EventType",
          "SourceNode",
          "SourceName",
          "Time",
          "ReceiveTime",
          "Message",
          "Severity",
          "ConditionId",
          "ConditionName",
          "BranchId",
          "Retain",
          "ConditionClassId",
          "ConditionClassName",
          "Quality",
          "LastSeverity",
          "Comment",
          "ClientUserId",
          "EnabledState",
          "AckedState",
          "ConfirmedState",
          "ActiveState",
          "HighLimit",
          "Temperature"
        ],
        "required": [
          "EventId",
          "EventType",
          "SourceNode",
          "SourceName",
          "Time",
          "ReceiveTime",
          "Message",
          "Severity",
          "ConditionId",
          "ConditionName",
          "BranchId",
          "Retain",
          "ConditionClassId",
          "ConditionClassName",
          "Quality",
          "LastSeverity",
          "Comment",
          "ClientUserId",
          "EnabledState"
        ],
        "properties": {
          "EventId": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "EventType": {
            "type": "string"
          },
          "SourceNode": {
            "type": "string"
          },
          "SourceName": {
            "type": "string"
          },
          "Time": {
            "type": "string",
            "format": "date-time"
          },
          "ReceiveTime": {
            "type": "string",
            "format": "date-time"
          },
          "Message": {
            "type": "string"
          },
          "Severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "ConditionId": {
            "type": "string"
          },
          "ConditionName": {
            "type": "string"
          },
          "BranchId": {
            "type": "string"
          },
          "Retain": {
            "type": "boolean"
          },
          "ConditionClassId": {
            "type": "string"
          },
          "ConditionClassName": {
            "type": "string"
          },
          "Quality": {
            "type": "string"
          },
          "LastSeverity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "Comment": {
            "type": "string"
          },
          "ClientUserId": {
            "type": "string"
          },
          "EnabledState": {
            "type": "object",
            "uav:fieldOrder": ["Name", "Id"],
            "properties": {
              "Name": {
                "type": "string"
              },
              "Id": {
                "type": "boolean"
              }
            }
          },
          "AckedState": {
            "type": "object",
            "uav:fieldOrder": ["Name", "Id"],
            "properties": {
              "Name": {
                "type": "string"
              },
              "Id": {
                "type": "boolean"
              }
            }
          },
          "ConfirmedState": {
            "type": "object",
            "uav:fieldOrder": ["Name", "Id"],
            "properties": {
              "Name": {
                "type": "string"
              },
              "Id": {
                "type": "boolean"
              }
            }
          },
          "ActiveState": {
            "type": "object",
            "uav:fieldOrder": ["Name", "Id"],
            "properties": {
              "Name": {
                "type": "string"
              },
              "Id": {
                "type": "boolean"
              }
            }
          },
          "HighLimit": {
            "type": "number",
            "unit": "Cel"
          },
          "Temperature": {
            "uav:browseName": "pump:Temperature",
            "type": "number",
            "unit": "Cel"
          }
        }
      }
    },
    "limitAlarm": {
      "@type": "uav:eventType",
      "title": "Limit Alarm",
      "description": "The EventType definition of the standard ua:LimitAlarmType. It declares the four limit fields that type declares and inherits the rest, which is what a definition named by a single select clause has to state: a clause uses it for the EventType identity and for the one field it names. It is therefore not effective and is not linked as a baseline.",
      "uav:isEvent": true,
      "uav:id": "i=2955",
      "uav:browseName": "ua:LimitAlarmType",
      "data": {
        "type": "object",
        "uav:fieldOrder": [
          "HighHighLimit",
          "HighLimit",
          "LowLimit",
          "LowLowLimit"
        ],
        "properties": {
          "HighHighLimit": {
            "type": "number"
          },
          "HighLimit": {
            "type": "number"
          },
          "LowLimit": {
            "type": "number"
          },
          "LowLowLimit": {
            "type": "number"
          }
        }
      }
    }
  }
}
