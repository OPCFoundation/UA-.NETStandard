<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Opc.Ua.Types.Tests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Console" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Private.Uri" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ObjectLayoutInspector" />
  </ItemGroup>
  <PropertyGroup Condition="'$(NetStandardTests)' == 'true'">
    <DefineConstants>$(DefineConstants);NET_STANDARD_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\Main.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Ua.Types\Opc.Ua.Types.csproj" />
    <!-- The shim provides the obsolete static helpers (ExtensionObject.ToArray / ToList, etc.)
         that ExtensionObjectTests asserts on. Remove this reference once the tests are migrated
         to the modern API. -->
    <ProjectReference Include="..\..\tools\Opc.Ua.MigrationAnalyzer.Core\Opc.Ua.MigrationAnalyzer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Test.Common\Opc.Ua.Test.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WoT Binding specification's worked examples, used as conformance
         fixtures. Two of them are golden pairs: a projection document and the
         resolved view the specification says it resolves to. They are vendored
         byte-for-byte and pinned by spec-examples.manifest.json, which records
         the source repository, branch, commit and per-file SHA-256 so a
         specification change cannot reach them unreviewed. -->
    <EmbeddedResource Include="Wot\Assets\*.jsonld" />
    <EmbeddedResource Include="Wot\Assets\spec-examples.manifest.json" />
    <EmbeddedResource Include="Wot\Assets\wot-binding-traceability.json" />
    <EmbeddedResource Include="Wot\Assets\wot-binding-vectors.json" />
    <EmbeddedResource Include="Wot\Assets\wot-spec-requirements.json" />
    <EmbeddedResource Include="Wot\Assets\wot-spec-statements.json" />
  </ItemGroup>
</Project>
