<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Opc.Ua.Generators.Tests</RootNamespace>
    <AssemblyName>Opc.Ua.Generators.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA2007;CA2000;CA1014;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- The samples match AppTargetFrameworks, which does not include net472, while
       the test frameworks do. Referencing a sample on net472 would fail to
       restore, so both the reference and every fixture that depends on it are
       excluded there. Forgetting this exact exclusion has broken CI before. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <ProjectReference Include="..\..\samples\GeneratorDeviceIntegrationServer\GeneratorDeviceIntegrationServer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="GeneratorDatasheetConformanceTests.cs" />
    <Compile Remove="GeneratorMethodTests.cs" />
    <Compile Remove="GeneratorProtectionAlarmNodeTests.cs" />
    <Compile Remove="GeneratorProtectionTests.cs" />
    <Compile Remove="GeneratorStateMachineTests.cs" />
    <Compile Remove="SimulationHarness.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
  </ItemGroup>
  <!-- The generated asset is read as text so the tests can assert the authoring
       contract the connector depends on. -->
  <ItemGroup>
    <None Include="..\..\samples\GeneratorDeviceIntegrationServer\Assets\generator.usda">
      <Link>Assets\generator.usda</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
