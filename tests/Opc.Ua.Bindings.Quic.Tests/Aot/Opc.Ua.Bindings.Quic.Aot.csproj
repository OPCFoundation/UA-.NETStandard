<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Bindings.Quic\Opc.Ua.Bindings.Quic.csproj"
                      Condition="'$(QuicPrebuiltReferencesDirectory)' == ''" />
    <Reference Include="$(QuicPrebuiltReferencesDirectory)\*.dll"
               Exclude="$(QuicPrebuiltReferencesDirectory)\opcua_quic_go.dll"
               Condition="'$(QuicPrebuiltReferencesDirectory)' != ''" />
    <Compile Include="..\NativeFlowTestEnvironment.cs" Link="NativeFlowTestEnvironment.cs" />
    <Compile Include="..\NativeFlowLiveScenario.cs" Link="NativeFlowLiveScenario.cs" />
  </ItemGroup>
</Project>
