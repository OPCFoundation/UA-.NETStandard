<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Opc.Ua.WotCon.Tests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- Lifecycle compatibility cases intentionally exercise the one-release obsolete extension shims.
         TODO: Remove CS0618 when those compatibility tests and shims are retired. -->
    <NoWarn>$(NoWarn);CS1591;CA2007;CA2000;CA1014;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Opc.Ua.Server.NodeManagerLifecycleExtensions" Static="true" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Common\Main.cs" />
    <Compile Include="..\Common\WotSpecVectors.cs" />
    <EmbeddedResource Include="..\Opc.Ua.Types.Tests\Wot\Assets\wot-binding-vectors.json">
      <LogicalName>wot-binding-vectors.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Bindings.Https\Opc.Ua.Bindings.Https.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.WotCon\Opc.Ua.WotCon.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.WotCon.Bindings\Opc.Ua.WotCon.Bindings.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.WotCon.Server\Opc.Ua.WotCon.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.WotCon.Client\Opc.Ua.WotCon.Client.csproj" />
    <ProjectReference Include="..\Opc.Ua.Server.TestFramework\Opc.Ua.Server.TestFramework.csproj" />
    <ProjectReference Include="..\Opc.Ua.Client.TestFramework\Opc.Ua.Client.TestFramework.csproj" />
    <ProjectReference Include="..\Opc.Ua.Test.Common\Opc.Ua.Test.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The stack-side evidence for the WoT specification requirements the
         specification leaves to an implementation. One file, embedded in every
         assembly that carries some of that evidence, because no test assembly
         can see another and a per-assembly copy would drift. -->
    <Compile Include="..\Opc.Ua.Types.Tests\Wot\WotSpecRequirementLedger.cs">
      <Link>Wot\WotSpecRequirementLedger.cs</Link>
    </Compile>
    <EmbeddedResource Include="..\Opc.Ua.Types.Tests\Wot\Assets\wot-spec-requirements.json">
      <Link>Wot\Assets\wot-spec-requirements.json</Link>
      <LogicalName>wot-spec-requirements.json</LogicalName>
    </EmbeddedResource>
    <Compile Include="..\Opc.Ua.Types.Tests\Wot\WotTraceabilityLedger.cs">
      <Link>Wot\WotTraceabilityLedger.cs</Link>
    </Compile>
    <EmbeddedResource Include="..\Opc.Ua.Types.Tests\Wot\Assets\wot-binding-traceability.json">
      <Link>Wot\Assets\wot-binding-traceability.json</Link>
      <LogicalName>wot-binding-traceability.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- The authoritative model sources, linked (not duplicated) into the test
         output so the parity tests also run from an external artifacts path. -->
    <Content Include="..\..\src\Opc.Ua.WotCon\Design\Opc.Ua.WotCon.NodeSet2.xml">
      <Link>Models\Opc.Ua.WotCon.NodeSet2.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Opc.Ua.WotCon\Design\Opc.Ua.WotCon.NodeSet2.csv">
      <Link>Models\Opc.Ua.WotCon.NodeSet2.csv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\Opc.Ua.XRegistry\Opc.Ua.XRegistry.NodeSet2.xml">
      <Link>Models\Opc.Ua.XRegistry.NodeSet2.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>