<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Opc.Ua.OpenUsd.Tests</RootNamespace>
    <AssemblyName>Opc.Ua.OpenUsd.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA2007;CA2000;CA1014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenUsd.Rendering"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Ua.OpenUsd.Client\Opc.Ua.OpenUsd.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.OpenUsd\Opc.Ua.OpenUsd.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.OpenUsd.Server\Opc.Ua.OpenUsd.Server.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Robotics\Opc.Ua.Robotics.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\..\tools\Opc.Ua.OpenUsd.Connector\Opc.Ua.OpenUsd.Connector.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\..\tools\Opc.Ua.OpenUsd.Connector.Viewer\Opc.Ua.OpenUsd.Connector.Viewer.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\..\samples\Robotics\IntentViewerClient\IntentViewerClient.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\..\samples\Robotics\IntentEnabledRobot\IntentEnabledRobot.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="OpenUsdConnectorRunnerTests.cs" />
    <Compile Remove="OpenUsdViewHostTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\*.usda">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- The layers above are a frozen reader/materializer fixture and must not be
       re-synchronised with the sample. The shipped MinimalRobotServer assets are linked
       in separately so RobotAssetContractTests can assert the live OPC UA binding
       contract against the files the server actually serves. -->
  <ItemGroup>
    <None Include="..\..\samples\Robotics\MinimalRobotServer\Assets\*.usda"
          Link="Assets\Sample\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\samples\OpenUsd\GeneratorServer\Assets\generator.usda"
          Link="Assets\Sample\generator.usda">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- GeneratorServer matches AppTargetFrameworks, which does not include net472,
       while the test frameworks do. Referencing it on net472 would fail to
       restore, so the reference and every fixture that reads the sample's
       internals are excluded there. GeneratorAssetContractTests only reads the
       authored .usda as text, so it stays on every framework. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <ProjectReference Include="..\..\samples\OpenUsd\GeneratorServer\GeneratorServer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="Generator\GeneratorDatasheetConformanceTests.cs" />
    <Compile Remove="Generator\GeneratorOpenUsdE2eTests.cs" />
    <Compile Remove="Generator\GeneratorMethodTests.cs" />
    <Compile Remove="Generator\GeneratorProtectionAlarmNodeTests.cs" />
    <Compile Remove="Generator\GeneratorProtectionTests.cs" />
    <Compile Remove="Generator\GeneratorStateMachineTests.cs" />
    <Compile Remove="Generator\SimulationHarness.cs" />
  </ItemGroup>
</Project>
