<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Follow CustomTestTarget like the other modern-only fuzz test projects so the
         CI leg's requested TFM always exists; RestrictForLegacyTfm then empties the
         project on legacy legs. Pinning net10.0 here makes a `dotnet test` run that
         requests net48 fail with NETSDK1005 before the shell can take effect. -->
    <TargetFrameworks Condition="'$(CustomTestTarget)' == ''">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == '' AND ('$(CustomTestTarget)' == 'netstandard2.0' OR '$(CustomTestTarget)' == 'netstandard2.1')">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">$(CustomTestTarget)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <RootNamespace>Opc.Ua.OneFuzz.Validator.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Opc.Ua.OneFuzz.Validator\Opc.Ua.OneFuzz.Validator.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Opc.Ua.OneFuzz.TestTarget\Opc.Ua.OneFuzz.TestTarget.csproj"
                      ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OneFuzzProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
