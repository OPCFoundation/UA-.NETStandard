<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pinned to net10.0 like the validator and test-target projects it references;
         RestrictForLegacyTfm empties it on legacy legs. The all-TFM matrix builds the
         solution with CustomTestTarget=net8.0/net9.0, so following CustomTestTarget
         here would target a framework its net10.0 references cannot satisfy. -->
    <TargetFramework>net10.0</TargetFramework>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <RootNamespace>Opc.Ua.OneFuzz.Validator.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\Opc.Ua.OneFuzz.Validator\Opc.Ua.OneFuzz.Validator.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Opc.Ua.OneFuzz.TestTarget\Opc.Ua.OneFuzz.TestTarget.csproj"
                      ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OneFuzzProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
