{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit OneFuzz ownership profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "worker", "ownership", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "framework", "architecture", "instrumentation"],
      "properties": {
        "os": { "const": "azurelinux3" },
        "framework": { "const": "net10.0" },
        "architecture": { "enum": ["x64", "arm64"] },
        "instrumentation": { "const": "service" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["JobNotificationEmail", "AdoTemplate", "CodeCoverage", "SdlWorkItemId"],
      "properties": {
        "JobNotificationEmail": { "type": "string", "format": "email", "minLength": 1 },
        "SdlWorkItemId": { "type": "integer", "minimum": 1 },
        "AdoTemplate": {
          "type": "object",
          "required": ["Org", "Project", "AssignedTo", "AreaPath", "IterationPath", "Type", "AdoFields", "UniqueFields"],
          "properties": {
            "Org": { "type": "string", "minLength": 1 },
            "Project": { "type": "string", "minLength": 1 },
            "AssignedTo": { "type": "string", "minLength": 1 },
            "AreaPath": { "type": "string", "minLength": 1 },
            "IterationPath": { "type": "string", "minLength": 1 },
            "Type": { "type": "string", "minLength": 1 },
            "AdoFields": { "type": "object", "minProperties": 1 },
            "UniqueFields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "Comment": { "type": "string" },
            "OnDuplicate": { "type": "object" }
          }
        },
        "CodeCoverage": {
          "type": "object",
          "required": ["Org", "Project", "PipelineId"],
          "properties": {
            "Org": { "type": "string", "minLength": 1 },
            "Project": { "type": "string", "minLength": 1 },
            "PipelineId": { "type": "string", "pattern": "^[1-9][0-9]*$" }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ProjectName", "TargetName", "SeedCorpusContainer"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "ProjectName": { "type": "string", "minLength": 1 },
          "TargetName": { "type": "string", "minLength": 1 },
          "SeedCorpusContainer": {
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "pattern": "^(?!.*--)[a-z0-9][a-z0-9-]*[a-z0-9]$"
          }
        }
      }
    }
  }
}
