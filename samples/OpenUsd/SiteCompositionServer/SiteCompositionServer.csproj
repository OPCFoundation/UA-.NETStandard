<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>SiteCompositionServer</AssemblyName>
    <PackageId>SiteCompositionServer</PackageId>
    <Description>Supervisory OPC UA server that composes the machines of several subordinate servers into a single OpenUSD scene, demonstrating cross-server composition at a SCADA level.</Description>
    <RootNamespace>SiteComposition</RootNamespace>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.OpenUsd\Opc.Ua.OpenUsd.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.OpenUsd.Server\Opc.Ua.OpenUsd.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <!-- The site shell: ground, buildings and the operator camera. The machines
       themselves are composed from the subordinate servers at runtime, so this
       layer deliberately contains no pump and no generator geometry. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Site.usda"><LogicalName>Site.usda</LogicalName></EmbeddedResource>
  </ItemGroup>
</Project>
