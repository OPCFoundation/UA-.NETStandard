<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(ModernTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>OnboardingClient</AssemblyName>
    <RootNamespace>OnboardingClientDemo</RootNamespace>
    <Description>OPC 10000-21 onboarding client sample.</Description>
    <PublishAot>true</PublishAot>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableFdoOnboarding)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_FDO_ONBOARDING</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableFdoOnboarding)' == 'true'">
    <ProjectReference Include="..\..\..\src\Opc.Ua.Gds.Fdo\Opc.Ua.Gds.Fdo.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableFdoOnboarding)' != 'true'">
    <Compile Remove="FdoEnrollment.cs" />
    <Compile Remove="FdoDeviceEnrollmentSetup.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Gds\Opc.Ua.Gds.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Gds.Client\Opc.Ua.Gds.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\OnboardingDevice\DevicePullJournal.cs" Link="DevicePullJournal.cs" />
    <Compile Include="..\OnboardingRegistrar\PushRegistrarCheckpointFiles.cs" Link="PushRegistrarCheckpointFiles.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
