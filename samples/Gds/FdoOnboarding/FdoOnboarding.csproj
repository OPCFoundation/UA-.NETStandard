<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <Description>Local paired FDO enrollment and OPC UA registrar handoff.</Description>
    <RestoreAdditionalProjectSources Condition="'$(FdoLocalFeed)' != ''">$(RestoreAdditionalProjectSources);$(FdoLocalFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Fdo" VersionOverride="[1.0.0-local.1328a26]" Condition="'$(FdoLocalFeed)' != ''" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Gds.Client\Opc.Ua.Gds.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Gds.Server\Opc.Ua.Gds.Server.csproj" />
    <Compile Include="..\OnboardingClient\OnboardingDeviceCredentials.cs" Link="OnboardingDeviceCredentials.cs" />
    <Compile Include="..\OnboardingDevice\DevicePullJournal.cs" Link="DevicePullJournal.cs"
             Condition="Exists('..\OnboardingDevice\DevicePullJournal.cs')" />
    <Compile Include="..\OnboardingRegistrar\FdoRegistrarEnrollmentPolicy.cs" Link="FdoRegistrarEnrollmentPolicy.cs" />
    <Compile Include="..\OnboardingRegistrar\PullRegistrarPolicy.cs" Link="PullRegistrarPolicy.cs" />
    <Compile Include="..\OnboardingRegistrar\PushRegistrarCheckpointFiles.cs" Link="PushRegistrarCheckpointFiles.cs" />
  </ItemGroup>
  <Target Name="RequireLocalFdo" BeforeTargets="PrepareForBuild" Condition="'$(FdoLocalFeed)' == ''">
    <Error Text="Set FdoLocalFeed to the absolute path of the authorized local FDO prerelease feed. See README.md." />
  </Target>
</Project>
