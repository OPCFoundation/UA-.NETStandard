d":"nsu=http://opcfoundation.org/UA/Pumps/;i=5014"},{"@id":"nsu=http://opcfoundation.org/UA/Pumps/;i=3016","@type":"uav:EnumDefinition","description":"defines flags for the category of explosion protection for devices according to EU Directive 2014/34/EU (ATEX)","uav:binaryEncodingId":"nsu=http://opcfoundation.org/UA/Pumps/;i=5004","uav:dataTypeId":"nsu=http://opcfoundation.org/UA/Pumps/;i=3016","uav:dataTypeName":"ns1:ExplosionProtectionOptionSet","uav:dataTypeSubtypeOf":{"uav:dataTypeId":"i=12755"},"uav:enumFields":[{"@type":"uav:EnumField","description":"This category is intended for use in underground mines and their surface installations which may be endangered by firedamp and/or combustible dust. Category 1 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a very high level of safety. (2014/34/EU)","uav:enumName":"M1","uav:enumValue":0},{"@type":"uav:EnumField","description":"This category is intended for use in underground mines and their surface installations which may be endangered by firedamp and/or combustible dust. Category 2 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a high level of safety. (2014/34/EU)","uav:enumName":"M2","uav:enumValue":1},{"@type":"uav:EnumField","description":"Devices in this category are intended for use in areas in which an explosive atmosphere consisting of a mixture of air and gases, vapours or mists is present. Category 1 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a very high level of safety. (2014/34/EU)","uav:enumName":"1G","uav:enumValue":2},{"@type":"uav:EnumField","description":"Devices in this category are intended for use in areas in which an explosive atmosphere consisting of a mixture of air and gases, vapours or mists is present. Category 2 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a high level of safety. (2014/34/EU)","uav:enumName":"2G","uav:enumValue":3},{"@type":"uav:EnumField","description":"Devices in this category are intended for use in areas in which an explosive atmosphere consisting of a mixture of air and gases, vapours or mists is present. Category 3 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a normal level of safety. (2014/34/EU)","uav:enumName":"3G","uav:enumValue":4},{"@type":"uav:EnumField","description":"Devices in this category are intended for use in areas in which an explosive atmosphere consisting of a mixture of air and dust is present. Category 1 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a very high level of safety. (2014/34/EU)","uav:enumName":"1D","uav:enumValue":5},{"@type":"uav:EnumField","description":"Devices in this category are intended for use in areas in which an explosive atmosphere consisting of a mixture of air and dust is present. Category 2 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a high level of safety. (2014/34/EU)","uav:enumName":"2D","uav:enumValue":6},{"@type":"uav:EnumField","description":"Devices in this category are intended for use in areas in which an explosive atmosphere consisting of a mixture of air and dust is present. Category 3 comprises devices designed to be capable of functioning in conformity with the parameters specified by the manufacturer and ensuring a normal level of safety. (2014/34/EU)","uav:enumName":"3D","uav:enumValue":7}],"uav:isOptionSet":true,"uav:jsonEncodingId":"nsu=http://opcfoundation.org/UA/Pumps/;i=5006","uav:xmlEncodingId":"nsu=http://opcfoundation.org/UA/Pumps/;i=5005"},{"@id":"nsu=http://opcfoundation.org/UA/Pumps/;i=3015","@type":"uav:EnumDefinition","description":"defines flags for the category of explosion zones for devices","uav:binaryEncodingId":"nsu=http://opcfoundation.org/UA/Pumps/;i=5001","uav:dataTypeId":"nsu=http://opcfoundation.org/UA/Pumps/;i=3015","uav:dataTypeName":"ns1:ExplosionZoneOptionSet","uav:dataTypeSubtypeOf":{"uav:dataTypeId":"i=12755"},"uav:enumFields":[{"@type":"uav:EnumField","description":"A zone in which an explosive atmosphere consisting of a mixture with air of flammable substances in the form of gas, vapour or mist is present continuously or for long periods or frequently.","uav:enumName":"Zone 0","uav:enumValue":0},{"@type":"uav:EnumField","description":"A zone in which an explosive atmosphere consisting of a mixture with air of flammable substances in the form of gas, vapour or mist is likely to occur in normal operation occasionally.","uav:enumName":"Zone 1","uav:enumValue":1},{"@type":"uav:EnumField","description":"A zone in which an explosive atmosphere consisting of a mixture with air of flammable substances in the form of gas, vapour or mist is not likely to occur in normal operation but, if it does occur, will persist for a short period only.","uav:enumName":"Zone 2","uav:enumValue":2},{"@type":"uav:EnumField","description":"A zone in which an explosive atmosphere in the form of a cloud of combustible dust in air is present continuously, for long periods or frequently.","uav:enumName":"Zone 20","uav:enumValue":3},{"@type":"uav:EnumField","description":"A zone in which an explosive atmosphere in the form of a cloud of combustible dust in air is likely to occur in normal operation occasionally.","uav:enumName":"Zone 21","uav:enumValue":4},{"@type":"uav:EnumField","description":"A zone in which an explosive atmosphere in the form of a cloud of combustible dust in air is not likely to occur in normal operation but, if it does occur, will persist for a short period only.","uav:enumName":"Zone 22","uav:enumValu