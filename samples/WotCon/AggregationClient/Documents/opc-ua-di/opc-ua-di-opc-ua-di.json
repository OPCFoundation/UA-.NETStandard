    {
      "@id": "nsu=http://opcfoundation.org/UA/DI/;i=408",
      "@type": "uav:EnumDefinition",
      "title": "SoftwareClass",
      "uav:dataTypeId": "nsu=http://opcfoundation.org/UA/DI/;i=408",
      "uav:dataTypeName": "ns1:SoftwareClass",
      "uav:dataTypeSubtypeOf": {
        "uav:dataTypeId": "i=29"
      },
      "uav:enumFields": [
        {
          "@type": "uav:EnumField",
          "description": "The software update is used for the firmware of a physical device.",
          "uav:enumName": "Firmware",
          "uav:enumValue": 0
        },
        {
          "@type": "uav:EnumField",
          "description": "The software update is used for an executable software.",
          "uav:enumName": "Application",
          "uav:enumValue": 1
        },
        {
          "@type": "uav:EnumField",
          "description": "The software update is used for the configuration of a device or application.",
          "uav:enumName": "Configuration",
          "uav:enumValue": 2
        },
        {
          "@type": "uav:EnumField",
          "description": "The software update is used to install a solution with several software package to several components.",
          "uav:enumName": "Solution",
          "uav:enumValue": 3
        }
      ],
      "uav:isOptionSet": false
    },
    {
      "@id": "nsu=http://opcfoundation.org/UA/DI/;i=410",
      "@type": "uav:EnumDefinition",
      "title": "LocationIndicationType",
      "uav:dataTypeId": "nsu=http://opcfoundation.org/UA/DI/;i=410",
      "uav:dataTypeName": "ns1:LocationIndicationType",
      "uav:dataTypeSubtypeOf": {
        "uav:dataTypeId": "i=5"
      },
      "uav:enumFields": [
        {
          "@type": "uav:EnumField",
          "description": "Location indication through optical signals, such as blinking LEDs, if supported by the device.",
          "uav:enumName": "Visual",
          "uav:enumValue": 0
        },
        {
          "@type": "uav:EnumField",
          "description": "Location indication through auditory signals, such as sounds or beeps, if supported by the device.",
          "uav:enumName": "Audible",
          "uav:enumValue": 1
        }
      ],
      "uav:isOptionSet": true
    },
    {
      "@id": "nsu=http://opcfoundation.org/UA/DI/;i=331",
      "@type": "uav:EnumDefinition",
      "title": "SoftwareVersionFileType",
      "uav:dataTypeId": "nsu=http://opcfoundation.org/UA/DI/;i=331",
      "uav:dataTypeName": "ns1:SoftwareVersionFileType",
      "uav:dataTypeSubtypeOf": {
        "uav:dataTypeId": "i=29"
      },
      "uav:enumFields": [
        {
          "@type": "uav:EnumField",
          "description": "The currently used version of the software identified by the CurrentVersion Object.",
          "uav:enumName": "Current",
          "uav:enumValue": 0
        },
        {
          "@type": "uav:EnumField",
          "description": "The pending version of the software that could be installed identified by the PendingVersion Object.",
          "uav:enumName": "Pending",
          "uav:enumValue": 1
        },
        {
          "@type": "uav:EnumField",
          "description": "The fallback version of the software identified by the FallbackVersion Object.",
          "uav:enumName": "Fallback",
          "uav:enumValue": 2
        }
      ],
      "uav:isOptionSet": false
    },
    {
      "@id": "nsu=http://opcfoundation.org/UA/DI/;i=333",
      "@type": "uav:EnumDefinition",
      "title": "UpdateBehavior",
      "uav:dataTypeId": "nsu=http://opcfoundation.org/UA/DI/;i=333",
      "uav:dataTypeName": "ns1:UpdateBehavior",
      "uav:dataTypeSubtypeOf": {
        "uav:dataTypeId": "i=7"
      },
      "uav:enumFields": [
        {
          "@type": "uav:EnumField",
          "description": "If KeepsParameters is not set, the device will lose its configuration during update. The Client should do a backup of the parameters before the update and restore them afterwards.",
          "uav:enumName": "KeepsParameters",
          "uav:enumValue": 0
        },
        {
          "@type": "uav:EnumField",
          "description": "If WillDisconnect is set, the OPC UA Server will restart during installation. This can be the case if the update is about the firmware of the device that hosts the OPC UA Server.",
          "uav:enumName": "WillDisconnect",
          "uav:enumValue": 1
        },
        {
          "@type": "uav:EnumField",
          "description": "If RequiresPowerCycle is set, the devices require a manual power off / power on for installation.",
          "uav:enumName": "RequiresPowerCycle",
          "uav:enumValue": 2
        },
        {
          "@type": "uav:EnumField",
          "description": "If WillReboot is set, the device will reboot during the update, inclusive of embedded infrastructure elements like an integrated switch. An update Client should take this into account since the devices behind an integrated switch are not reachable for that time.",
          "uav:enumName": "WillReboot",
          "uav:enumValue": 3
        },
        {
          "@type": "uav:EnumField",
          "description": "If NeedsPreparation is not set, the Client can install the update without maintaining the PrepareForUpdateStateMachine. This can be used to support an installation without stopping the software.",
          "uav:enumName": "NeedsPreparation",
          "uav:enumValue": 4
        }
      ],
      "uav:isOptionSet": true
    }
  ],
