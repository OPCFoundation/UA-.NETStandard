<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AiModelManagementServer</AssemblyName>
    <!-- net48 is deliberately absent: see AiModelManagement.Bridge.csproj. -->
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>AiModelManagement.Server</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0108</NoWarn>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The workload-identity path resolves tokens through a library that
         serialises by reflection, which native AOT warns on and this repository
         builds warnings as errors. Nothing in the OPC UA surface needs AOT; see
         README.md. -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiModelManagement.Bridge\AiModelManagement.Bridge.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.XRegistry\Opc.Ua.XRegistry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
