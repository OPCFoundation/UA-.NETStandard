<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AiModelManagement.Bridge</AssemblyName>
    <!-- net48 is deliberately absent. AppTargetFrameworks includes it, but the AI
         client packages this sample builds on target modern .NET only. -->
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>AiModelManagement.Bridge</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0108</NoWarn>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The cloud backend reaches a hosted inference service through an SDK that
         serialises by reflection. Native AOT and trimming warn on that, and this
         repository builds warnings as errors, so the sample is published without
         AOT. See README.md; nothing about the OPC UA surface requires it. -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.XRegistry\Opc.Ua.XRegistry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- The AI Model Management model is source-generated from its NodeSet2 XML. Its
       catalogue types subtype the abstract registry in OPC UA - xRegistry, which is
       why Opc.Ua.XRegistry is referenced rather than that NodeSet being carried
       here: the arrangement Opc.Ua.Robotics uses for its DI and IA dependencies. -->
  <ItemGroup>
    <None Remove="..\Model\Opc.Ua.AiModelManagement.NodeSet2.xml" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\Model\Opc.Ua.AiModelManagement.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/AI/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorPrefix>Opc.Ua.AiModelManagement</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
  </ItemGroup>
  <Import Project="..\..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
</Project>
