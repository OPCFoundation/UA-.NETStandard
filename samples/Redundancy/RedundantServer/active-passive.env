# Active/passive, strong consistency (Raft). Exactly one replica is the Raft leader
# (the active writer); the other two are hot standbys that take over on leader loss.
# The 3-node RaftCs cluster keeps a quorum (2 of 3) when one replica fails.
#
#   docker compose --env-file samples/Redundancy/RedundantServer/active-passive.env \
#     -f samples/Redundancy/RedundantServer/docker-compose.yml up --build
HA_MODE=ap
HA_CONSISTENCY=strong
REDUNDANCY_MODE=hot
CLIENT_REPLICAS=1
HA_HISTORIAN=true
HA_FAST_RECONNECT=true
# The distributed historian fails closed without protected shared records.
# Set one shared value before starting Compose, for example:
#   export HA_RECORD_KEY=$(openssl rand -base64 32)
# Provision this value from a Kubernetes Secret / KMS in production.
