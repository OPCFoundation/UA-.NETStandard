<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>CranesHoistsServer</AssemblyName>
    <PackageId>CranesHoistsServer</PackageId>
    <RootNamespace>CranesHoistsSample.Server</RootNamespace>
    <Description>Bounded OPC 40020-1 crane server with simulated acquisitions and explicit limit requests.</Description>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.CranesHoists.Server\Opc.Ua.CranesHoists.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SampleArguments.cs" Link="SampleArguments.cs" />
  </ItemGroup>
</Project>
