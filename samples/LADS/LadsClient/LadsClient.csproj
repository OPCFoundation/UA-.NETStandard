<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>LadsClient</AssemblyName>
    <PackageId>LadsClient</PackageId>
    <RootNamespace>LadsSample.Client</RootNamespace>
    <Description>Console OPC UA client that discovers a LADS (OPC 30500-1) device with Opc.Ua.LADS.Client, runs an incubation program, monitors its functions and downloads the result file.</Description>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.LADS.Client\Opc.Ua.LADS.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
