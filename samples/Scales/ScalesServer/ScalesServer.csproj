<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>ScalesServer</AssemblyName>
    <PackageId>ScalesServer</PackageId>
    <RootNamespace>ScalesSample</RootNamespace>
    <Description>Self-contained .NET console OPC UA server publishing an OPC 40200 packing line with the Opc.Ua.Scales.Server builders: a scale system with a checkweigher, infeed feeder and label printer, a laboratory scale, a piece-counting scale, a vehicle scale and a recipe scale, driven by a simulation that weighs packages, updates statistics and raises scale events and alarms.</Description>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Scales.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Scales.Server\Opc.Ua.Scales.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
