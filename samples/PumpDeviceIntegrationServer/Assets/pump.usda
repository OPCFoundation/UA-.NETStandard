        )
        {
            uniform token axis = "Z"
            double height = 0.018
            double radius = 0.0925
            color3f[] primvars:displayColor = [(0.02, 0.22, 0.55)]
            rel material:binding = </Pump/Looks/PumpBlue>
            double3 xformOp:translate = (-0.645, 0, 0.539)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "BoltFront" (
