        )
        {
            uniform token axis = "Z"
            double height = 0.032
            double radius = 0.009
            color3f[] primvars:displayColor = [(0.55, 0.56, 0.58)]
            rel material:binding = </Pump/Looks/Galvanised>
            double3 xformOp:translate = (-0.645, 0.0725, 0.539)
            uniform token[] xformOpOrder = ["xformOp:translate"]
