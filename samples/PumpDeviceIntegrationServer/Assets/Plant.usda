                )
                {
                    uniform token axis = "Z"
                    double height = 0.150
                    double radius = 0.043
                    color3f[] primvars:displayColor = [(0.02, 0.22, 0.55)]
                    rel material:binding = </Plant/Looks/PumpBlue>
                    double3 xformOp:translate = (-0.645, 0, 0.455)
