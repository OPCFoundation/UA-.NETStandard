                }

                def Cube "BracketFoot" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    double size = 1.0
                    color3f[] primvars:displayColor = [(0.02, 0.20, 0.50)]
                    rel material:binding = </Plant/Looks/PumpBlue>
                    double3 xformOp:translate = (-0.360, 0, 0.1875)
                    double3 xformOp:scale = (0.16, 0.20, 0.105)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }

                def Cylinder "SightGlass" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    uniform token axis = "Y"
                    double height = 0.020
