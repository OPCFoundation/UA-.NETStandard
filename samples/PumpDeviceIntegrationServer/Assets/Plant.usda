                    double3 xformOp:scale = (0.10, 0.014, 0.05)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }

            def Cylinder "Body" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token axis = "X"
                double height = 0.110
                double radius = 0.1775
                color3f[] primvars:displayColor = [(0.02, 0.24, 0.60)]
