      <ModelSourceGeneratorPrefix>Opc.Ua.Recycling.Model</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <EmbeddedResource Include="Model\Recycling.xml" LogicalName="Recycling.Model.xml" />
