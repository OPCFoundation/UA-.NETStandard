  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Recycling.Samples.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Model\Recycling.xml">
      <ModelSourceGeneratorModelUri>urn:opcfoundation.org:sample:recycling</ModelSourceGeneratorModelUri>
