    <opc:Children>
      <opc:Property SymbolicName="MachineId" DataType="ua:String" ModellingRule="Mandatory" />
      <opc:Property SymbolicName="Process" DataType="ProcessEnum" ModellingRule="Mandatory" />
      <opc:Property SymbolicName="StageIndex" DataType="ua:Int32" ModellingRule="Mandatory" />
      <opc:Property SymbolicName="BindingStatus" DataType="ua:String" ModellingRule="Mandatory" />
      <opc:Property SymbolicName="SignalOrigin" DataType="ua:String" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Stage" DataType="StageDataType" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Available" DataType="ua:Boolean" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="RunState" DataType="EquipmentEnum" ModellingRule="Mandatory">
        <opc:Description>run_state: committed sample equipment state; not a standard companion enumeration.</opc:Description>
      </opc:Variable>
      <opc:Variable SymbolicName="Timestamp" DataType="ua:DateTime" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Revision" DataType="ua:Int64" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Tick" DataType="ua:Int64" ModellingRule="Mandatory" />
