      <opc:Property SymbolicName="LineId" DataType="ua:String" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="State" DataType="SnapshotDataType" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Available" DataType="ua:Boolean" ModellingRule="Mandatory" />
      <opc:Method SymbolicName="Execute" TypeDefinition="ExecuteCommandMethodType" ModellingRule="Mandatory" />
      <opc:Method SymbolicName="ReadSnapshot" TypeDefinition="ReadSnapshotMethodType" ModellingRule="Mandatory" />
      <opc:Method SymbolicName="ReadGenealogy" TypeDefinition="ReadGenealogyMethodType" ModellingRule="Mandatory" />
    </opc:Children>
  </opc:ObjectType>
  <opc:ObjectType SymbolicName="RecyclingProcessViewType" BaseType="ua:BaseObjectType" NumericId="3002">
    <opc:Description>Sample projection/control seam. Companion equipment binding is separate and is not implied by this type.</opc:Description>
    <opc:Children>
      <opc:Property SymbolicName="LineId" DataType="ua:String" ModellingRule="Mandatory" />
      <opc:Property SymbolicName="Process" DataType="ProcessEnum" ModellingRule="Mandatory" />
      <opc:Property SymbolicName="CompanionBindingsComplete" DataType="ua:Boolean" ModellingRule="Mandatory">
        <opc:Description>The selected read-only native equipment bindings are implemented and verified. Does not assert original-source parity, optional remote production controls or profile certification.</opc:Description>
      </opc:Property>
      <opc:Variable SymbolicName="State" DataType="SnapshotDataType" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Available" DataType="ua:Boolean" ModellingRule="Mandatory" />
      <opc:Method SymbolicName="ForwardCommand" TypeDefinition="ExecuteCommandMethodType" ModellingRule="Mandatory" />
      <opc:Method SymbolicName="ReadSnapshot" TypeDefinition="ReadSnapshotMethodType" ModellingRule="Mandatory" />
    </opc:Children>
  </opc:ObjectType>
