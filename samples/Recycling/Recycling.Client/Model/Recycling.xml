      <opc:Variable SymbolicName="Contributions" DataType="ContributionDataType" ValueRank="Array" ModellingRule="Mandatory" />
      <opc:Variable SymbolicName="Executions" DataType="ua:Int64" ModellingRule="Mandatory" />
