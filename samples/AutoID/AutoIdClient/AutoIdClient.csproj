<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>AutoIdClient</AssemblyName>
    <PackageId>AutoIdClient</PackageId>
    <RootNamespace>AutoIdSample.Client</RootNamespace>
    <Description>Console client that discovers the OPC 30010 readers of a server with Opc.Ua.AutoID.Client, scans for tags, reads and writes tag memory, starts an asynchronous scan and prints the scan and presence events it delivers.</Description>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.AutoID.Client\Opc.Ua.AutoID.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
