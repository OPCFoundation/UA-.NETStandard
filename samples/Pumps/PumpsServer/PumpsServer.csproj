<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>PumpsServer</AssemblyName>
    <PackageId>PumpsServer</PackageId>
    <RootNamespace>PumpsSample</RootNamespace>
    <Description>Self-contained .NET console OPC UA server publishing two OPC 40223 pumps with the Opc.Ua.Pumps.Server builders: nameplate, configuration, live measurements with engineering units, signals, supervision, maintenance, multi-pump roles, ports and documentation links, driven by a simulation that publishes every change to subscribed clients.</Description>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Pumps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Pumps.Server\Opc.Ua.Pumps.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
