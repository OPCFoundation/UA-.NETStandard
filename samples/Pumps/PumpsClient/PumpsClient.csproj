<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>PumpsClient</AssemblyName>
    <PackageId>PumpsClient</PackageId>
    <RootNamespace>PumpsSample.Client</RootNamespace>
    <Description>Console client that discovers every OPC 40223 pump of a server with Opc.Ua.Pumps.Client, prints nameplate, configuration, measurements with units, supervision, maintenance, multi-pump role, ports and documentation, and then streams live measurements and supervision changes.</Description>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Pumps.Client\Opc.Ua.Pumps.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
