<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>VisualInspectionAgent</AssemblyName>
    <PackageId>VisualInspectionAgent</PackageId>
    <Description>Orchestrating client for the Vision visual-inspection sample cell.</Description>
    <RootNamespace>Vision.VisualInspectionAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1014;CA1812;CA1822;CA1852</NoWarn>
    <PublishAot>false</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.AI\Opc.Ua.AI.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.AI.Client\Opc.Ua.AI.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.ISA95\Opc.Ua.ISA95.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.ISA95.Client\Opc.Ua.ISA95.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Vision\Opc.Ua.Vision.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Vision.Client\Opc.Ua.Vision.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
