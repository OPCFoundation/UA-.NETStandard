#usda 1.0
(
    doc = """Base robot-cell asset for the OPC UA - OpenUSD Bindings Robotics end-to-end.

    Authored by the 3D / USD asset author actor. It carries only the static cell environment. The generic connector composes the aggregated robot references into live.usda; this base layer provides only positioned /Cell/Robots/R1 and /Cell/Robots/R2 mount-point Xforms.

    The cell is sized to contain the real motion envelope: each robot base travels +/-0.6 m in X about +/-1.2 m and each KR 16-2 arm reaches 1.611 m, so the floor spans 7.2 x 4.8 m with the guarding at x = +/-3.4 and y = +/-2.2.

    Every gprim carries both a material binding and a matching primvars:displayColor, so the cell reads correctly on renderers that ignore the material graph.
    """
    defaultPrim = "Cell"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cell"
{
    custom double inputs:speedOverride = 100

    def Xform "Floor"
    {
        def Cube "Slab" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.34, 0.35, 0.36)]
            rel material:binding = </Cell/Materials/Concrete>
            double3 xformOp:translate = (0, 0, -0.030)
            double3 xformOp:scale = (7.2, 4.8, 0.030)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WorkZone" (
