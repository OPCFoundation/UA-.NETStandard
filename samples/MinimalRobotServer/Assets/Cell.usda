            }
        }

        def Material "CabinetGrey"
        {
            token outputs:surface.connect = </Cell/Materials/CabinetGrey/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
