<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>AmbClient</AssemblyName>
    <PackageId>AmbClient</PackageId>
    <RootNamespace>AmbSample.Client</RootNamespace>
    <Description>Console client that discovers the manageable assets of a server with Opc.Ua.AMB.Client, prints a snapshot of each with identification, health, maintenance, documentation links, locations and structure, adds and removes a documentation link, and streams health alarms and maintenance activities, acknowledging cleared alarms.</Description>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.AMB.Client\Opc.Ua.AMB.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
