<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>MachineToolServer</AssemblyName>
    <PackageId>MachineToolServer</PackageId>
    <RootNamespace>MachineToolSample.Server</RootNamespace>
    <Description>Bounded MachineTool and wireless peripheral server with explicit simulated providers.</Description>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.MachineTool.Server\Opc.Ua.MachineTool.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SampleArguments.cs" Link="SampleArguments.cs" />
    <Compile Include="..\DemoContract.cs" Link="DemoContract.cs" />
  </ItemGroup>
</Project>
