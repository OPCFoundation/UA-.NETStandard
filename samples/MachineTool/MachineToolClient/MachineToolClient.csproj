<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>MachineToolClient</AssemblyName>
    <PackageId>MachineToolClient</PackageId>
    <RootNamespace>MachineToolSample.Client</RootNamespace>
    <Description>Passive-by-default typed MachineTool and wireless peripheral client with bounded workflows.</Description>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.MachineTool.Client\Opc.Ua.MachineTool.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SampleArguments.cs" Link="SampleArguments.cs" />
    <Compile Include="..\DemoContract.cs" Link="DemoContract.cs" />
  </ItemGroup>
</Project>
