<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>ConsoleDataChannelAudio</AssemblyName>
    <PackageId>ConsoleDataChannelAudio</PackageId>
    <Company>OPC Foundation</Company>
    <Description>Finite opaque PCM messages over authenticated OPC UA flow carriers, with headless WAV output and Windows playback.</Description>
    <Copyright>Copyright © 2004-2026 OPC Foundation, Inc</Copyright>
    <!-- Opt into the root Directory.Build.targets no-op shape on per-TFM CI
         matrix entries that pin CustomTestTarget to a TFM this app cannot
         target. -->
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Bindings.Quic\Opc.Ua.Bindings.Quic.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Bindings.WebTransport\Opc.Ua.Bindings.WebTransport.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Application setup and complete-message ownership are identical to the streaming sample.
         Protocol negotiation and all carrier implementations remain in the production libraries. -->
    <Compile Include="..\ConsoleDataChannelStreaming\SampleOptions.cs" Link="Shared\SampleOptions.cs" />
    <Compile Include="..\ConsoleDataChannelStreaming\SampleIdentityPair.cs" Link="Shared\SampleIdentityPair.cs" />
    <Compile Include="..\ConsoleDataChannelStreaming\SamplePolicy.cs" Link="Shared\SamplePolicy.cs" />
    <Compile Include="..\ConsoleDataChannelStreaming\StreamingHarness.cs" Link="Shared\StreamingHarness.cs" />
    <Compile Include="..\ConsoleDataChannelStreaming\ServiceTraffic.cs" Link="Shared\ServiceTraffic.cs" />
    <Compile Include="..\ConsoleDataChannelStreaming\MessageWorkload.cs" Link="Shared\MessageWorkload.cs" />
    <Compile Include="..\ConsoleDataChannelStreaming\SampleResult.cs" Link="Shared\SampleResult.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- NAudio (MIT) plays the streamed audio. Nothing under src/ references
         it: audio output is the sample's concern, not the stack's. -->
    <PackageReference Include="NAudio" />
  </ItemGroup>
</Project>
