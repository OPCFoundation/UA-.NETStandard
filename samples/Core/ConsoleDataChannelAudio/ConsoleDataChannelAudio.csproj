<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>ConsoleDataChannelAudio</AssemblyName>
    <PackageId>ConsoleDataChannelAudio</PackageId>
    <Company>OPC Foundation</Company>
    <Description>Experimental console sample that streams looping audio over an OPC UA data channel and plays it back.</Description>
    <Copyright>Copyright © 2004-2026 OPC Foundation, Inc</Copyright>
    <Nullable>enable</Nullable>
    <!-- CA1812/CA1822: a console sample does not need instantiation analysis
         or static members. DataChannels: the sample exists to demonstrate the
         experimental surface, so it opts in deliberately. -->
    <NoWarn>$(NoWarn);CA1812;CA1822;DataChannels</NoWarn>
    <!-- Opt into the root Directory.Build.targets no-op shape on per-TFM CI
         matrix entries that pin CustomTestTarget to a TFM this app cannot
         target. -->
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Opc.Ua.Server\Opc.Ua.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- NAudio (MIT) plays the streamed audio. Nothing under src/ references
         it: audio output is the sample's concern, not the stack's. -->
    <PackageReference Include="NAudio" />
  </ItemGroup>
</Project>
