<Project Sdk="Microsoft.NET.Sdk">
  <!-- Server load / profiling harness. Not part of the product; see perf/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The measured server process runs with the .NET defaults (workstation, concurrent GC)
         so that results describe an unconfigured deployment; SERVER_DOTNET_gcServer=1
         switches the server child to Server GC for comparison. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tests\Opc.Ua.Client.TestFramework\Opc.Ua.Client.TestFramework.csproj" />
    <ProjectReference Include="..\..\tests\Opc.Ua.Server.TestFramework\Opc.Ua.Server.TestFramework.csproj" />
  </ItemGroup>
</Project>
