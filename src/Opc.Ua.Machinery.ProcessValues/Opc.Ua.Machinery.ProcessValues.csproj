<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Machinery.ProcessValues</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Machinery.ProcessValues</PackageId>
    <RootNamespace>Opc.Ua.Machinery.ProcessValues</RootNamespace>
    <!-- CS0109 joins the usual CS0108 suppression because the ObjectType proxy
         generator decides the "new" modifier from the method's browse name
         alone (ObjectTypeProxyGenerator.isShadow) rather than from its
         signature, so a narrowed inherited method emits a redundant "new".
         Generated modifiers cannot be hand-tuned. -->
    <NoWarn>$(NoWarn);CS1591;CS0108;CS0109</NoWarn>
    <Nullable>enable</Nullable>
    <Description>Source-generated OPC 40001-2 Machinery Process Values information model over the OPC 30081 PADIM model and the OPC UA IRDI dictionary.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Server" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Client" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Tests" />
  </ItemGroup>
  <!-- Opc.Ua.PADIM supplies both the PADIM model (AnalogSignalType 1022 and
       AnalogSignalVariableType 1111, which this model's two types derive from)
       and the IRDI dictionary the specification names as a RequiredModel. DI is
       a declared RequiredModel of OPC 40001-2 but no node in this NodeSet binds
       a DI type, so it arrives transitively through Opc.Ua.PADIM. -->
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.PADIM\Opc.Ua.PADIM.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Model\Opc.Ua.Machinery.ProcessValues.NodeSet2.xml" />
    <None Remove="Model\Opc.Ua.Machinery.ProcessValues.NodeIds.csv" />
  </ItemGroup>
  <!-- The identifier file is a drift guard, not a NodeId source - for a
       NodeSet2 input the NodeIds come from the XML. It is derived from the
       upstream publication with tools/nodesets/derive-identifier-table.py;
       Model\*.Upstream.NodeIds.csv is that publication unmodified and is kept
       out of AdditionalFiles so the two can be diffed. -->
  <ItemGroup>
    <AdditionalFiles Include="Model\Opc.Ua.Machinery.ProcessValues.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/Machinery/ProcessValues/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>MachineryProcessValues</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Machinery.ProcessValues</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.Machinery.ProcessValues.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.Machinery.ProcessValues.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
