<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Vision.Machinery.Server</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Vision.Machinery.Server</PackageId>
    <RootNamespace>Opc.Ua.Vision.Server</RootNamespace>
    <Description>OPC 40100-2 Machine Vision asset management and condition monitoring, with generated fluent accessors, transactional telemetry updates and shared DI/Machinery hosting.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Vision.Machinery\Opc.Ua.Vision.Machinery.csproj" />
    <ProjectReference Include="..\Opc.Ua.Vision.Server\Opc.Ua.Vision.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery.Server\Opc.Ua.Machinery.Server.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <InternalsVisibleTo Include="Opc.Ua.Vision.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\Opc.Ua.Vision.Machinery\Model\Opc.Ua.MachineVision.AMCM.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/MachineVision/AMCM/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>MachineVisionAmcm</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Vision.MachineVision.AMCM</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorFluentAccessorsOnly>true</ModelSourceGeneratorFluentAccessorsOnly>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
