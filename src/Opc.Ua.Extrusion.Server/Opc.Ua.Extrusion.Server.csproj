<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Extrusion.Server</AssemblyName>
    <RootNamespace>Opc.Ua.Extrusion.Server</RootNamespace>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Extrusion.Server</PackageId>
    <Description>Composable, provider-backed OPC 40084 parts 1 through 12 extrusion devices, production jobs, state and event behavior.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Extrusion.Tests" />
    <ProjectReference Include="..\Opc.Ua.Machinery.Server\Opc.Ua.Machinery.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.PlasticsRubber.Server\Opc.Ua.PlasticsRubber.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion\Opc.Ua.Extrusion.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Line\Opc.Ua.Extrusion.Line.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Extruder\Opc.Ua.Extrusion.Extruder.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.HaulOff\Opc.Ua.Extrusion.HaulOff.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.MeltPump\Opc.Ua.Extrusion.MeltPump.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Filter\Opc.Ua.Extrusion.Filter.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Die\Opc.Ua.Extrusion.Die.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Pelletizer\Opc.Ua.Extrusion.Pelletizer.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Cutter\Opc.Ua.Extrusion.Cutter.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Calibrator\Opc.Ua.Extrusion.Calibrator.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Corrugator\Opc.Ua.Extrusion.Corrugator.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion.Calender\Opc.Ua.Extrusion.Calender.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
    <None Include="..\Opc.Ua.PlasticsRubber\Model\NOTICE.txt"
          Pack="true" PackagePath="licenses\CompanionModels.NOTICE.txt" />
  </ItemGroup>
</Project>
