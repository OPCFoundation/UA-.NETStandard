<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Scales.Server</AssemblyName>
    <DefineConstants>$(DefineConstants);OPCUA_INCLUDE_ASYNC</DefineConstants>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Scales.Server</PackageId>
    <RootNamespace>Opc.Ua.Scales.Server</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <Description>Server hosting for the source-generated OPC 40200 Weighing Technology (Scales) model: a DI-based node manager that materialises scales and scale systems into the DeviceSet and the Machinery Machines folder, a weighing runtime behind CurrentWeight/RegisteredWeight and the zero, tare and register methods, production preset and product management with DI locking, the PackML state machine, scale events and alarms, the type-specific methods of every scale type, recipe management, and fluent application configuration APIs.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Scales.Tests" />
  </ItemGroup>
  <!-- Opc.Ua.IA and Opc.Ua.PackML are referenced explicitly: the node manager
       loads IA ahead of Machinery (Machinery's Stacklight is typed by the IA
       BasicStacklightType) and PackML ahead of Scales (ScaleDeviceType/State
       is typed by the PackML state machines). Opc.Ua.Machinery.Server is
       deliberately not referenced, as in Opc.Ua.Pumps.Server: it would pull
       ISA-95 Job Control, energy, process-value and result transfer into
       every weighing server. -->
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Server\Opc.Ua.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.Scales\Opc.Ua.Scales.csproj" />
    <ProjectReference Include="..\Opc.Ua.Di.Server\Opc.Ua.Di.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.IA\Opc.Ua.IA.csproj" />
    <ProjectReference Include="..\Opc.Ua.PackML\Opc.Ua.PackML.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- The Scales NodeSet is linked, not copied: with
       ModelSourceGeneratorFluentAccessorsOnly the generator emits only the
       typed fluent accessors here and takes the model itself from
       Opc.Ua.Scales, which publishes it with OmitFluentApi. That assembly has
       to stay among the ProjectReferences above or this fails with
       MODELGEN014. -->
  <ItemGroup>
    <AdditionalFiles Include="..\Opc.Ua.Scales\Model\Opc.Ua.Scales.NodeSet2.xml">
      <Link>Model\Opc.Ua.Scales.NodeSet2.xml</Link>
      <ModelSourceGeneratorPrefix>Opc.Ua.Scales</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorFluentAccessorsOnly>true</ModelSourceGeneratorFluentAccessorsOnly>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
