<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Machinery.Jobs</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Machinery.Jobs</PackageId>
    <RootNamespace>Opc.Ua.Machinery.Jobs</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0108</NoWarn>
    <Nullable>enable</Nullable>
    <Description>Source-generated OPC 40001-3 Machinery Job Management information model over the OPC 10031-4 ISA-95 Job Control V2 model.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Server" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Client" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Tests" />
  </ItemGroup>
  <!-- OPC 40001-3 sits on ISA-95 Job Control V2 alone; it declares no DI, IA or
       Machinery dependency, so this assembly does not reference
       Opc.Ua.Machinery. JobManagementType's two mandatory children,
       JobOrderControl and JobOrderResults, are instances of the Job Control V2
       ISA95JobOrderReceiverObjectType (ns=2;i=1002) and
       ISA95JobResponseProviderObjectType (ns=2;i=1003) shipped in
       Opc.Ua.ISA95, whose Model element is exactly the 2.0.0 / 2024-01-31
       revision this model requires. -->
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.ISA95\Opc.Ua.ISA95.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Model\Opc.Ua.Machinery.Jobs.NodeSet2.xml" />
    <None Remove="Model\Opc.Ua.Machinery.Jobs.NodeIds.csv" />
  </ItemGroup>
  <!-- Upstream publishes this NodeSet as Opc.Ua.Machinery.Jobs.Nodeset2.xml
       (lower-case "s"); it is renamed here to match the other four parts. The
       upstream path is recorded in docs/Machinery.md.

       The identifier file is a drift guard, not a NodeId source - for a
       NodeSet2 input the NodeIds come from the XML. It is derived from the
       upstream publication with tools/nodesets/derive-identifier-table.py;
       Model\*.Upstream.NodeIds.csv is that publication unmodified and is kept
       out of AdditionalFiles so the two can be diffed. -->
  <ItemGroup>
    <AdditionalFiles Include="Model\Opc.Ua.Machinery.Jobs.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/Machinery/Jobs/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>MachineryJobs</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Machinery.Jobs</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.Machinery.Jobs.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.Machinery.Jobs.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
