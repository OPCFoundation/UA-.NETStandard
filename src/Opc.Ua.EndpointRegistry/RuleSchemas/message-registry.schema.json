{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opcfoundation:EndpointRegistry:0.2.0:registry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "documentation": {
      "type": "string"
    },
    "self": {
      "type": "string"
    },
    "xid": {
      "type": "string"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "createdat": {
      "type": "string"
    },
    "modifiedat": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "registryid": {
      "type": "string",
      "minLength": 1
    },
    "specversion": {
      "const": "1.0-rc4"
    },
    "messagegroups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:opcfoundation:EndpointRegistry:0.2.0:messagegroup"
      }
    }
  },
  "additionalProperties": true,
  "required": [
    "registryid"
  ]
}
