<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(CustomTestTarget)' == ''">net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CustomTestTarget)' == 'net8.0' or '$(CustomTestTarget)' == 'net9.0' or '$(CustomTestTarget)' == 'net10.0'">$(CustomTestTarget)</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">$(LibCoreTargetFrameworks)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <AssemblyName>$(AssemblyPrefix).Bindings.WebTransport</AssemblyName>
    <PackageId>$(PackagePrefix).Opc.Ua.Bindings.WebTransport</PackageId>
    <RootNamespace>Opc.Ua.Bindings</RootNamespace>
    <Description>Optional native WebTransport draft-16 binding for the common OPC UA flow runtime.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExperimentalAttribute">
      <_Parameter1>DataChannels</_Parameter1>
      <UrlFormat>https://github.com/OPCFoundation/UA-.NETStandard/blob/master/docs/DataChannels.md</UrlFormat>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Bindings.Quic\Opc.Ua.Bindings.Quic.csproj" />
    <!-- Restore drops ReferenceOutputAssembly=false edges. Keep the native package dependency,
         but never copy or expose the packaging project's placeholder managed assembly. -->
    <ProjectReference Include="..\Opc.Ua.Native.Http3\Opc.Ua.Native.Http3.csproj"
                      IncludeAssets="runtime;native" Private="false" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <InternalsVisibleTo Include="Opc.Ua.Bindings.WebTransport.Tests" />
    <InternalsVisibleTo Include="Opc.Ua.DataChannel.ClientServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="GetPackagingOutputs" />
</Project>
