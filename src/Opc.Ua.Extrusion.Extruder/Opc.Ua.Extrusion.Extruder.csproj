<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Extrusion.Extruder</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Extrusion.Extruder</PackageId>
    <RootNamespace>Opc.Ua.Extrusion.Extruder</RootNamespace>
    <Description>OPC 40084-3 model foundations: typed states, data types, client proxies and compiled model loading.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\Opc.Ua.Di\Opc.Ua.Di.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery\Opc.Ua.Machinery.csproj" />
    <ProjectReference Include="..\Opc.Ua.PlasticsRubber\Opc.Ua.PlasticsRubber.csproj" />
    <ProjectReference Include="..\Opc.Ua.Extrusion\Opc.Ua.Extrusion.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Model\Opc.Ua.Extrusion.Extruder.NodeSet2.xml" />
    <None Remove="Model\Opc.Ua.Extrusion.Extruder.NodeIds.csv" />
    <AdditionalFiles Include="Model\Opc.Ua.Extrusion.Extruder.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/PlasticsRubber/Extrusion_v2/Extruder/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>ExtrusionExtruder</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Extrusion.Extruder</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.Extrusion.Extruder.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.Extrusion.Extruder.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
    <ModelSourceGeneratorEmitDependencyMetadata>true</ModelSourceGeneratorEmitDependencyMetadata>
    <ModelSourceGeneratorPublicDataTypeExtensions>true</ModelSourceGeneratorPublicDataTypeExtensions>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
    <None Include="..\Opc.Ua.PlasticsRubber\Model\NOTICE.txt"
          Pack="true" PackagePath="licenses\CompanionModels.NOTICE.txt" />
  </ItemGroup>
</Project>
