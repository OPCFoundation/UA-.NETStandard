<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).SchemaRegistry.Formats</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.SchemaRegistry.Formats</PackageId>
    <RootNamespace>Opc.Ua.SchemaRegistry.Formats</RootNamespace>
    <Description>Lossless native schema-document providers for the OPC UA Schema Registry.</Description>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.SchemaRegistry\Opc.Ua.SchemaRegistry.csproj" />
    <Compile Include="..\Opc.Ua.SchemaRegistry\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
