FROM docker.io/library/rust@sha256:b5a086f64ffecaa4e283063184770107915756739598173e1f5712d6b34b84d0 AS native
WORKDIR /work
ENV CARGO_HOME=/work/cargo-home CARGO_TARGET_DIR=/work/target \
    TMPDIR=/work/work TMP=/work/work TEMP=/work/work \
    RUSTFLAGS="--remap-path-prefix=/work=."
COPY src/ ./src/
COPY tests/ ./tests/
RUN mkdir -p /work/work /work/cargo-home \
    && rustc -vV \
    && rustc -vV | grep -F 'commit-hash: 2d8144b7880597b6e6d3dfd63a9a9efae3f533d3'
WORKDIR /work/src/Opc.Ua.Native.Http3
# Formatting and Clippy run on the same source with the public Windows compiler.
# The accepted Linux image contains rustc/cargo/std, not rustfmt or Clippy.
RUN cargo test --offline --locked --workspace --quiet \
    && cc -std=c11 -Werror -Wall -Wextra -Iinclude \
        ../../tests/Opc.Ua.Native.Http3.Tests/native/abi-layout.c -o /work/abi-layout \
    && /work/abi-layout \
    && cargo build --offline --locked --release --lib -p opcua-native-http3 --quiet
FROM scratch
COPY --from=native /work/target/release/libopcua_http3.so /native/libopcua_http3.so
