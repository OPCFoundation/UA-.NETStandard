<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).PackML.Client</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.PackML.Client</PackageId>
    <RootNamespace>Opc.Ua.PackML.Client</RootNamespace>
    <Description>Typed client APIs for OPC 30050 PackML.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\Opc.Ua.PackML\Opc.Ua.PackML.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\Opc.Ua.PackML\Model\Opc.Ua.PackML.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/PackML/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>PackML</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.PackML</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.PackML.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="..\Opc.Ua.PackML\Model\Opc.Ua.PackML.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorClientAccessorsOnly>true</ModelSourceGeneratorClientAccessorsOnly>
    <ModelSourceGeneratorClientAccessorNamespace>Opc.Ua.PackML.Client</ModelSourceGeneratorClientAccessorNamespace>
    <ModelSourceGeneratorClientAccessorClassName>PackMLClientMembers</ModelSourceGeneratorClientAccessorClassName>
  </PropertyGroup>
</Project>
