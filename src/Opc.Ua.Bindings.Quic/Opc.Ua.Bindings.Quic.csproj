<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- QUIC needs net9.0: System.Net.Quic is behind RequiresPreviewFeatures on
         net8.0, so the shipped package is net9.0;net10.0. A UA.slnx build pinned
         to one TFM via CustomTestTarget builds the rest of the stack for that
         TFM alone, so the pin has to be followed here too - keeping both legs
         would leave the other one referencing a stack that was never built for
         it (NU1201). Pins this project cannot host at all are no-ops through
         RestrictForLegacyTfm below. -->
    <TargetFrameworks Condition="'$(CustomTestTarget)' == ''">net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CustomTestTarget)' == 'net9.0' or '$(CustomTestTarget)' == 'net10.0'">$(CustomTestTarget)</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">$(LibCoreTargetFrameworks)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <RestrictForLegacyTfmAdditionalTargets>net8.0</RestrictForLegacyTfmAdditionalTargets>
    <AssemblyName>$(AssemblyPrefix).Bindings.Quic</AssemblyName>
    <PackageId>$(PackagePrefix).Opc.Ua.Bindings.Quic</PackageId>
    <RootNamespace>Opc.Ua.Bindings</RootNamespace>
    <Description>Experimental OPC UA QUIC Binding Library. Implements the opc.quic transport of the OPC UA Data Channels errata. Identifiers are provisional.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <!-- System.Net.Quic is available only where msquic is present.
         Availability is checked at run time through
         QuicConnection.IsSupported rather than at compile time. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Core.DataChannels.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\Opc.Ua.Core.Channels\Opc.Ua.Core.Channels.csproj" />
    <ProjectReference Include="..\Opc.Ua.Server\Opc.Ua.Server.csproj" />
  </ItemGroup>
  <Target Name="GetPackagingOutputs" />
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
