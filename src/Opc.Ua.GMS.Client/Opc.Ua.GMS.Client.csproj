<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).GMS.Client</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.GMS.Client</PackageId>
    <RootNamespace>Opc.Ua.GMS.Client</RootNamespace>
    <Description>Bounded OPC 40210 GMS result queries, metadata, characteristics, corrections and result-file downloads using generated proxies and standard OPC UA file transfer.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.GMS\Opc.Ua.GMS.csproj" />
    <ProjectReference Include="..\Opc.Ua.MachineTool.Client\Opc.Ua.MachineTool.Client.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery.Client\Opc.Ua.Machinery.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
