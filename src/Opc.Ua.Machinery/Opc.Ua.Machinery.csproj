<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Machinery</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Machinery</PackageId>
    <RootNamespace>Opc.Ua.Machinery</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0108</NoWarn>
    <Nullable>enable</Nullable>
    <Description>Server/client-independent OPC 40001-1 Machinery Basic Building Blocks contracts and source-generated model over the OPC 10000-200 Industrial Automation and OPC 10000-100 DI base models, including model identifiers, typed node states and client proxies.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Server" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Client" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Tests" />
  </ItemGroup>
  <!-- OPC 40001-1 binds DI (FunctionalGroupType 1005, ITagNameplateType 15048,
       IVendorNameplateType 15035 and friends) and IA at exactly one place:
       MonitoringType/Status/Stacklight (ns=1;i=5050) has IA BasicStacklightType
       as its type definition, and the StacklightOperationMode alias resolves
       into IA as well. That single edge is why src/Opc.Ua.IA exists as its own
       assembly - without a payload-bearing producer for the IA namespace the
       model generator cannot resolve those nodes, which is what the samples'
       reduced NodeSet copies were working around. -->
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Di\Opc.Ua.Di.csproj" />
    <ProjectReference Include="..\Opc.Ua.IA\Opc.Ua.IA.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Model\Opc.Ua.Machinery.NodeSet2.xml" />
    <None Remove="Model\Opc.Ua.Machinery.NodeIds.csv" />
  </ItemGroup>
  <!-- The identifier file is not a NodeId source - for a NodeSet2 input the
       NodeIds come from the XML. It is a drift guard: the generator validates
       every row against the imported symbols and fails the build when the
       upstream model and the pinned mapping disagree.
       Model\Opc.Ua.Machinery.Upstream.NodeIds.csv is the unmodified OPC
       Foundation publication, kept out of AdditionalFiles so the two can be
       diffed. The only repair is stripping the "Server_Namespaces_" prefix the
       publication adds to the namespace-metadata rows, which the NodeSet itself
       does not carry. -->
  <ItemGroup>
    <AdditionalFiles Include="Model\Opc.Ua.Machinery.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/Machinery/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>Machinery</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Machinery</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.Machinery.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.Machinery.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <!-- Model-only assembly: opt out of typed-accessor emission since the
         emitted code references Opc.Ua.Server.Fluent.* which this project does
         not reference. Opc.Ua.Machinery.Server re-links this NodeSet with
         ModelSourceGeneratorFluentAccessorsOnly to supply them. -->
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
