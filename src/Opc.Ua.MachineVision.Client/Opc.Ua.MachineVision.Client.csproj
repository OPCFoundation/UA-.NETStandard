<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).MachineVision.Client</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.MachineVision.Client</PackageId>
    <RootNamespace>Opc.Ua.Vision.Client</RootNamespace>
    <Description>Typed OPC 40100-2 Machine Vision asset discovery, identification, condition-monitoring snapshots and relationship clients.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.MachineVision\Opc.Ua.MachineVision.csproj" />
    <ProjectReference Include="..\Opc.Ua.Vision.Client\Opc.Ua.Vision.Client.csproj" />
    <InternalsVisibleTo Include="Opc.Ua.Vision.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
