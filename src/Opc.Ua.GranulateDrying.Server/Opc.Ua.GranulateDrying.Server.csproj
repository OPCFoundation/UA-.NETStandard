<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).GranulateDrying.Server</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.GranulateDrying.Server</PackageId>
    <RootNamespace>Opc.Ua.GranulateDrying.Server</RootNamespace>
    <Description>Provider-backed OPC 40082-6 granulate drying devices, selectable capabilities, committed process values, and composable Machinery hosting.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.GranulateDrying.Tests" />
    <ProjectReference Include="..\Opc.Ua.GranulateDrying\Opc.Ua.GranulateDrying.csproj" />
    <ProjectReference Include="..\Opc.Ua.PlasticsRubber.Server\Opc.Ua.PlasticsRubber.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery.Server\Opc.Ua.Machinery.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
    <None Include="..\Opc.Ua.PlasticsRubber\Model\NOTICE.txt" Pack="true"
          PackagePath="licenses\CompanionModels.NOTICE.txt" />
  </ItemGroup>
</Project>
