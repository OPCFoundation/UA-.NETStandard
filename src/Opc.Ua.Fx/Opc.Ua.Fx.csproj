<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Fx</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Fx</PackageId>
    <RootNamespace>Opc.Ua.Fx</RootNamespace>
    <Description>OPC UA FX Part 81 Data, AutomationComponent and ConnectionManager information models.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible
        Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Di\Opc.Ua.Di.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="Model\opc.ua.fx.data.nodeset2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/FX/Data/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>FxData</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Fx.Data</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\opc.ua.fx.ac.nodeset2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/FX/AC/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>FxAc</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Fx.Ac</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\opc.ua.fx.cm.nodeset2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/FX/CM/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>FxCm</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.Fx.Cm</ModelSourceGeneratorPrefix>
    </AdditionalFiles>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
