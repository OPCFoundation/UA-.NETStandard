<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).Pumps.Client</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.Pumps.Client</PackageId>
    <RootNamespace>Opc.Ua.Pumps.Client</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Client-side helpers for the OPC 40223 Pumps and Vacuum Pumps companion specification: discover pumps below the DI DeviceSet and the Machinery Machines folder, read their nameplate, design, implementation and system-requirement groups, sample live measurements and signals, evaluate the supervision groups, read maintenance figures, browse the drive and connection ports, and take a full pump snapshot in one pass.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Pumps.Tests" />
  </ItemGroup>
  <!-- Opc.Ua.Machinery.Client is deliberately not referenced. PumpType is a
       MachineType, so a caller that wants the OPC 40001 building blocks adds
       that package alongside this one; pulling it in here would drag the
       ISA95 Job Control, process-value, energy and result-transfer packages
       into every pump client that only wants to read a flow rate. The DI
       topology client is referenced because pump discovery starts at the
       DeviceSet. -->
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\Opc.Ua.Pumps\Opc.Ua.Pumps.csproj" />
    <ProjectReference Include="..\Opc.Ua.Di.Client\Opc.Ua.Di.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
