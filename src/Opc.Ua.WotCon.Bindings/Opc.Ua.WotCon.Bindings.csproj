<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).WotCon.Bindings</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.WotCon.Bindings</PackageId>
    <RootNamespace>Opc.Ua.WotCon.Bindings</RootNamespace>
    <Nullable>enable</Nullable>
    <Description>OPC UA WoT Connectivity protocol-binding abstractions, planners, and net8.0+ HTTP, Modbus TCP, and OPC UA executors</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.WotCon.Server" />
    <InternalsVisibleTo Include="Opc.Ua.WotCon.Bindings.Mqtt" />
    <InternalsVisibleTo Include="Opc.Ua.WotCon.Bindings.Tests" />
    <InternalsVisibleTo Include="Opc.Ua.WotCon.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.WotCon\Opc.Ua.WotCon.csproj" />
    <ProjectReference
      Include="..\Opc.Ua.Client\Opc.Ua.Client.csproj"
      Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <Compile Remove="Http\**\*.cs" />
    <Compile Remove="Modbus\**\*.cs" />
    <Compile Remove="OpcUa\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
