<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).SchemaRegistry</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.SchemaRegistry</PackageId>
    <RootNamespace>Opc.Ua.SchemaRegistry</RootNamespace>
    <Description>OPC UA Schema Registry information model, native schema contents and explicit schema selection contracts.</Description>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.XRegistry\Opc.Ua.XRegistry.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\Opc.Ua.XRegistry\Opc.Ua.XRegistry.NodeSet2.xml">
      <ModelSourceGeneratorPrefix>Opc.Ua.XRegistry</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorName>XRegistry</ModelSourceGeneratorName>
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/xRegistry/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorIgnore>true</ModelSourceGeneratorIgnore>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.SchemaRegistry.NodeSet2.xml">
      <ModelSourceGeneratorPrefix>Opc.Ua.SchemaRegistry</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorName>SchemaRegistry</ModelSourceGeneratorName>
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/SchemaRegistry/</ModelSourceGeneratorModelUri>
    </AdditionalFiles>
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
    <None Update="Model\Opc.Ua.SchemaRegistry.NodeSet2.xml" Pack="true" PackagePath="model\" />
    <None Update="Model\Opc.Ua.SchemaRegistry.NodeIds.csv" Pack="true" PackagePath="model\" />
  </ItemGroup>
</Project>
