<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).EndpointRegistry.PubSub</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.EndpointRegistry.PubSub</PackageId>
    <RootNamespace>Opc.Ua.EndpointRegistry.PubSub</RootNamespace>
    <Description>OPC 30455 PubSub Binding facet: native correspondence, lifecycle-safe references and read-only local and authenticated remote surfacing.</Description>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.EndpointRegistry\Opc.Ua.EndpointRegistry.csproj" />
    <ProjectReference Include="..\Opc.Ua.EndpointRegistry.Server\Opc.Ua.EndpointRegistry.Server.csproj" />
    <ProjectReference Include="..\Opc.Ua.PubSub\Opc.Ua.PubSub.csproj" />
    <ProjectReference Include="..\Opc.Ua.PubSub.Server\Opc.Ua.PubSub.Server.csproj" />
    <Compile Include="..\Opc.Ua.EndpointRegistry\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="GetPackagingOutputs" />
</Project>
