<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).CranesHoists</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.CranesHoists</PackageId>
    <RootNamespace>Opc.Ua.CranesHoists</RootNamespace>
    <Description>Source-generated OPC 40020-1 Cranes and Hoists models, typed states, client proxies, model loaders and shared provider/snapshot contracts over the existing Robotics, Machinery and DI models.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.CranesHoists.Server" />
    <InternalsVisibleTo Include="Opc.Ua.CranesHoists.Client" />
    <InternalsVisibleTo Include="Opc.Ua.CranesHoists.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Di\Opc.Ua.Di.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery\Opc.Ua.Machinery.csproj" />
    <ProjectReference Include="..\Opc.Ua.Robotics\Opc.Ua.Robotics.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Model\Opc.Ua.CranesHoists.NodeSet2.xml" />
    <None Remove="Model\Opc.Ua.CranesHoists.NodeIds.csv" />
    <AdditionalFiles Include="Model\Opc.Ua.CranesHoists.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/CranesHoists/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>CranesHoists</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.CranesHoists</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.CranesHoists.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <!-- This locally derived drift table is not an upstream publication.
         The pinned NodeSet is the authoritative source of all identifiers. -->
    <AdditionalFiles Include="Model\Opc.Ua.CranesHoists.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
