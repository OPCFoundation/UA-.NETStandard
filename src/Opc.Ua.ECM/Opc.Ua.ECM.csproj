<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).ECM</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.ECM</PackageId>
    <RootNamespace>Opc.Ua.ECM</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS0108;CS0109</NoWarn>
    <Nullable>enable</Nullable>
    <Description>Source-generated OPC 34100 Energy Consumption Management (ECM) information model over the OPC 10000-200 Industrial Automation and OPC 10000-100 DI base models.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Energy" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Server" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Client" />
    <InternalsVisibleTo Include="Opc.Ua.Machinery.Tests" />
  </ItemGroup>
  <!-- ECM binds DI (its LockingServices) and IA (EnergyMeasurementType
       implements an IA interface). DI is named explicitly rather than relied on
       transitively through Opc.Ua.IA: ECM's own nodes reference DI types
       directly, and relying on a transitive reference for a direct dependency
       is how a later refactor silently breaks the build. -->
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Di\Opc.Ua.Di.csproj" />
    <ProjectReference Include="..\Opc.Ua.IA\Opc.Ua.IA.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Model\Opc.Ua.ECM.NodeSet2.xml" />
    <None Remove="Model\Opc.Ua.ECM.NodeIds.csv" />
  </ItemGroup>
  <!-- Upstream publishes the identifier table as Opc.Ua.ECM.NodeSet2.csv rather
       than the *.NodeIds.csv every other model uses; it is vendored under the
       repository's own name. It is a drift guard, not a NodeId source - for a
       NodeSet2 input the NodeIds come from the XML. Derived from the upstream
       publication with tools/nodesets/derive-identifier-table.py;
       Model\*.Upstream.NodeIds.csv is that publication unmodified and is kept
       out of AdditionalFiles so the two can be diffed. -->
  <ItemGroup>
    <AdditionalFiles Include="Model\Opc.Ua.ECM.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/ECM/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>ECM</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.ECM</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.ECM.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\Opc.Ua.ECM.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
