<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).MachineTool</AssemblyName>
    <TargetFrameworks>$(LibTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.MachineTool</PackageId>
    <RootNamespace>Opc.Ua.MachineTool</RootNamespace>
    <Description>Server/client-independent OPC 40501-1 MachineTool and OPC 40505 Wireless Machine Tool Peripherals models, with independently selectable generated types, factories and client proxies.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Machinery\Opc.Ua.Machinery.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery.Jobs\Opc.Ua.Machinery.Jobs.csproj" />
    <ProjectReference Include="..\Opc.Ua.Machinery.ProcessValues\Opc.Ua.Machinery.ProcessValues.csproj" />
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <!-- The package references the union of both dependency closures, but the
       models remain independently loadable. All dependency declarations come
       from their existing model assemblies, never duplicate generator inputs. -->
  <ItemGroup>
    <None Remove="Model\MachineTool\Opc.Ua.MachineTool.NodeSet2.xml" />
    <None Remove="Model\MachineTool\Opc.Ua.MachineTool.Derived.NodeIds.csv" />
    <None Remove="Model\WMTP\Opc.Ua.WMTP.Nodeset2.xml" />
    <None Remove="Model\WMTP\Opc.Ua.WMTP.Derived.NodeIds.csv" />
    <AdditionalFiles Include="Model\MachineTool\Opc.Ua.MachineTool.NodeSet2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/MachineTool/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>MachineTool</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.MachineTool</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.MachineTool.Derived.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\MachineTool\Opc.Ua.MachineTool.Derived.NodeIds.csv" />
    <AdditionalFiles Include="Model\WMTP\Opc.Ua.WMTP.Nodeset2.xml">
      <ModelSourceGeneratorModelUri>http://opcfoundation.org/UA/WMTP/</ModelSourceGeneratorModelUri>
      <ModelSourceGeneratorName>WMTP</ModelSourceGeneratorName>
      <ModelSourceGeneratorPrefix>Opc.Ua.MachineTool.WMTP</ModelSourceGeneratorPrefix>
      <ModelSourceGeneratorIdentifierFile>Opc.Ua.WMTP.Derived.NodeIds.csv</ModelSourceGeneratorIdentifierFile>
    </AdditionalFiles>
    <AdditionalFiles Include="Model\WMTP\Opc.Ua.WMTP.Derived.NodeIds.csv" />
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
