<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>$(AssemblyPrefix).PubSub</AssemblyName>
    <TargetFrameworks>$(LibxTargetFrameworks)</TargetFrameworks>
    <PackageId>$(PackagePrefix).Opc.Ua.PubSub</PackageId>
    <RootNamespace>Opc.Ua.PubSub</RootNamespace>
    <Description>OPC UA PubSub Class Library</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!--
      IUaPubSubDataStore is marked [Obsolete(DiagnosticId = "UA0023")] so consumer
      code sees the migration warning, but the modern PubSubApplicationBuilder and
      DataStoreBackedPublishedDataSetSource still consume it, so we suppress
      UA0023 + CS0618 within the library while keeping the warnings active for
      downstream consumers.
    -->
    <NoWarn>$(NoWarn);UA0023;CS0618;CS1591;UA_NETStandard_Avro;UA_NETStandard_Arrow</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.PubSub.Tests" />
    <InternalsVisibleTo Include="Opc.Ua.PubSub.Diagnostics.Tests" />
    <InternalsVisibleTo Include="Opc.Ua.PubSub.Udp.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\Opc.Ua.Core.Schema\Opc.Ua.Core.Schema.csproj" />
    <ProjectReference Include="..\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\Opc.Ua.XRegistry\Opc.Ua.XRegistry.csproj" />
    <ProjectReference Include="..\Opc.Ua.XRegistry.Client\Opc.Ua.XRegistry.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Opc.Ua.SourceGeneration\Opc.Ua.SourceGeneration.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="..\..\tools\Opc.Ua.SourceGeneration\OPCFoundation.Opc.Ua.SourceGeneration.props" />
  <PropertyGroup>
    <ModelSourceGeneratorVersion>v105</ModelSourceGeneratorVersion>
    <!-- Model-only assembly: opt out of typed-accessor emission since the
         emitted code references Opc.Ua.Server.Fluent.* which this project
         does not reference. The xRegistry base model is resolved from the
         referenced Opc.Ua.XRegistry assembly's ModelDependency metadata. -->
    <ModelSourceGeneratorOmitFluentApi>true</ModelSourceGeneratorOmitFluentApi>
    <ModelSourceGeneratorUseAllowSubtypes>true</ModelSourceGeneratorUseAllowSubtypes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SchemaRegistry\Opc.Ua.SchemaRegistry.NodeSet2.xml" LogicalName="Opc.Ua.PubSub.SchemaRegistry.Opc.Ua.SchemaRegistry.NodeSet2.xml" />
    <AdditionalFiles Include="SchemaRegistry\Opc.Ua.SchemaRegistry.NodeSet2.xml" />
    <!-- Part 14 configuration model additions for the Avro message mapping (Avro companion
         specification §9). Shipped as an independent Information Model extension so it can be
         adopted without changing the Part 14 NodeSet. Configuration only: no DataTypeEncoding
         Objects, because "Default Avro" has no AddressSpace representation (§4.2). -->
    <EmbeddedResource Include="Encoding\Avro\Opc.Ua.Avro.NodeSet2.xml" LogicalName="Opc.Ua.PubSub.Encoding.Avro.Opc.Ua.Avro.NodeSet2.xml" />
    <AdditionalFiles Include="Encoding\Avro\Opc.Ua.Avro.NodeSet2.xml" />
    <!-- Part 14 configuration model additions for the Arrow message mapping (Arrow companion
         specification §6.5). -->
    <EmbeddedResource Include="Encoding\Arrow\Opc.Ua.Arrow.NodeSet2.xml" LogicalName="Opc.Ua.PubSub.Encoding.Arrow.Opc.Ua.Arrow.NodeSet2.xml" />
    <AdditionalFiles Include="Encoding\Arrow\Opc.Ua.Arrow.NodeSet2.xml" />
    <!-- The Schema Registry NodeSet declares a RequiredModel on the abstract xRegistry base model.
         Opc.Ua.XRegistry compiles that model into its assembly and no longer ships it as a runtime
         NodeSet, so embed the base document here to keep the runtime import path self-contained. -->
    <EmbeddedResource Include="..\Opc.Ua.XRegistry\Opc.Ua.XRegistry.NodeSet2.xml" LogicalName="Opc.Ua.PubSub.SchemaRegistry.Opc.Ua.XRegistry.NodeSet2.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <!-- Apache.Arrow backs the Arrow PubSub adapter; only referenced on the modern
       target frameworks where the Arrow encoding is compiled (net8+). -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="Apache.Arrow" />
  </ItemGroup>
  <Choose>
    <When Condition="'$(TargetFramework)' != 'netstandard2.1' AND '$(TargetFramework)' != 'net48' and '$(TargetFramework)' != 'net472'">
      <ItemGroup>
        <PackageReference Include="MQTTnet" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="MQTTnet" VersionOverride="4.3.7.1207" />
      </ItemGroup>
    </Otherwise>
  </Choose>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <!--
      System.Net.NetworkInformation is an in-box assembly on modern TFMs
      (netstandard2.1, net8.0+); only the .NET Framework targets need an
      explicit reference to the framework assembly.
    -->
    <Reference Include="System.Net.NetworkInformation" />
  </ItemGroup>
  <Target Name="GetPackagingOutputs" />
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
