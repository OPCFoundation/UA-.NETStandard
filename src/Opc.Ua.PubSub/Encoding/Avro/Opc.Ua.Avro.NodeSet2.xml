      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=64021</Reference>
    </References>
  </UAVariable>

  <UAObjectType NodeId="ns=1;i=64022" BrowseName="1:AvroDataSetReaderMessageType">
    <DisplayName>AvroDataSetReaderMessageType</DisplayName>
    <Description>The Avro message mapping options of a DataSetReader (§9.4).</Description>
    <Category>PubSub Parameters Avro</Category>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=21104</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=64032</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=64033</Reference>
    </References>
  </UAObjectType>
  <UAVariable NodeId="ns=1;i=64032" BrowseName="1:NetworkMessageContentMask" ParentNodeId="ns=1;i=64022" DataType="ns=1;i=64000">
    <DisplayName>NetworkMessageContentMask</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasModellingRule">i=78</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=64022</Reference>
    </References>
  </UAVariable>
  <UAVariable NodeId="ns=1;i=64033" BrowseName="1:DataSetMessageContentMask" ParentNodeId="ns=1;i=64022" DataType="ns=1;i=64001">
    <DisplayName>DataSetMessageContentMask</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasModellingRule">i=78</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=64022</Reference>
    </References>
  </UAVariable>
</UANodeSet>
