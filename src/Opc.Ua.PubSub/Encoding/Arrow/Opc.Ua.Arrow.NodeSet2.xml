  <!-- §6.5 supporting enumerations. These are framing and transport options over the identical
       canonical column layout, so none of them is an encoding variant. -->
  <UADataType NodeId="ns=1;i=65000" BrowseName="1:ArrowIpcFormatEnum">
    <DisplayName>ArrowIpcFormatEnum</DisplayName>
    <Description>Selects how an Arrow NetworkMessage payload is framed (Arrow companion specification Table 6.2-1). Batch is the default: a bare RecordBatch whose schema is conveyed once out of band and resolved by SchemaId.</Description>
    <Category>PubSub Parameters Arrow</Category>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=29</Reference>
    </References>
    <Definition Name="ArrowIpcFormatEnum">
      <Field Name="Batch" Value="0" />
      <Field Name="Stream" Value="1" />
      <Field Name="File" Value="2" />
    </Definition>
  </UADataType>

  <UADataType NodeId="ns=1;i=65001" BrowseName="1:ArrowDeltaFrameModeEnum">
    <DisplayName>ArrowDeltaFrameModeEnum</DisplayName>
    <Description>Selects how a delta or sparse frame is represented (§6.2). NullableColumns keeps the full column set - and therefore one stable schema and SchemaId - marking absent keys as null cells; SelectedColumns drops columns and changes the SchemaId.</Description>
    <Category>PubSub Parameters Arrow</Category>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=29</Reference>
    </References>
    <Definition Name="ArrowDeltaFrameModeEnum">
      <Field Name="NullableColumns" Value="0" />
      <Field Name="SelectedColumns" Value="1" />
    </Definition>
  </UADataType>

  <UADataType NodeId="ns=1;i=65002" BrowseName="1:ArrowCompressionEnum">
    <DisplayName>ArrowCompressionEnum</DisplayName>
    <Description>Selects the Arrow IPC body compression codec (§6.1).</Description>
    <Category>PubSub Parameters Arrow</Category>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=29</Reference>
    </References>
    <Definition Name="ArrowCompressionEnum">
      <Field Name="None" Value="0" />
      <Field Name="Lz4Frame" Value="1" />
      <Field Name="Zstd" Value="2" />
    </Definition>
  </UADataType>

  <!-- §6.5 MessageSettings DataTypes. -->
  <UADataType NodeId="ns=1;i=65010" BrowseName="1:ArrowWriterGroupMessageDataType">
    <DisplayName>ArrowWriterGroupMessageDataType</DisplayName>
    <Description>WriterGroup MessageSettings for the Arrow message mapping. A WriterGroup uses the Arrow mapping if and only if its MessageSettings is of this DataType.</Description>
    <Category>PubSub Parameters Arrow</Category>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=15616</Reference>
    </References>
    <Definition Name="ArrowWriterGroupMessageDataType">
      <Field Name="ArrowIpcFormat" DataType="ns=1;i=65000">
        <Description>Payload framing (Table 6.2-1).</Description>
      </Field>
      <Field Name="MaxRowsPerRecordBatch" DataType="i=7">
        <Description>Batching target for rows per RecordBatch.</Description>
      </Field>
      <Field Name="IncludeSchemaMetadata" DataType="i=1">
        <Description>Whether NetworkMessage header fields are carried as schema metadata (§6.6).</Description>
      </Field>
      <Field Name="DeltaFrameMode" DataType="ns=1;i=65001">
        <Description>Delta and sparse frame representation (§6.2).</Description>
      </Field>
      <Field Name="Compression" DataType="ns=1;i=65002">
        <Description>Arrow IPC body compression codec.</Description>
      </Field>
      <Field Name="ArrowSchemaUri" DataType="i=12">
        <Description>Optional URI of the schema registry or catalog serving this group's schemas.</Description>
      </Field>
    </Definition>
  </UADataType>

  <UADataType NodeId="ns=1;i=65011" BrowseName="1:ArrowDataSetWriterMessageDataType">
    <DisplayName>ArrowDataSetWriterMessageDataType</DisplayName>
