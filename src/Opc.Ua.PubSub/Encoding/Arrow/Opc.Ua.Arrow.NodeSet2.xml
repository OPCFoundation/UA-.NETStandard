      </Field>
      <Field Name="DataSetFieldContentMask" DataType="i=15583">
        <Description>Selects the RawData, Variant or DataValue column representation (§6.2).</Description>
      </Field>
    </Definition>
  </UADataType>

  <UADataType NodeId="ns=1;i=65012" BrowseName="1:ArrowDataSetReaderMessageDataType">
