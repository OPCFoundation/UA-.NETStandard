<Project>
  <!--
    Packaging shared by the source generator `*.Pack` projects.

    A pack project owns nothing but the package identity; it lists the generator
    variants it ships in `@(SourceGeneratorVariant)`, each stamped with the
    `analyzers/dotnet/<folder>/cs` folder its Roslyn API version maps to.

    The payload is collected by globbing each variant's output directory rather
    than by enumerating assemblies, so any package or project added to a
    generator's dependency tree flows into every Roslyn folder without touching
    a project file.

    Assemblies the Roslyn host itself supplies are excluded. Shipping a second
    copy of Microsoft.CodeAnalysis*, System.Collections.Immutable or
    System.Reflection.Metadata makes the analyzer load context bind a different
    identity for types the compiler passes across its own API surface (most
    visibly ImmutableArray<T>), which fails at generator-initialization time with
    MissingMethodException - reported as warning CS8784, i.e. silently no
    generated code. See tools/RoslynVariants.props for the full rationale.

    The `ProjectReference` entries exist purely for build ordering and NuGet
    graph correctness. `ReferenceOutputAssembly` is off, the assemblies are
    taken from disk. That also keeps packing with `NoBuild` working, where the
    variants were built by a preceding solution build.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- The analyzer payload is custom package content, so no build-output symbol package is produced. -->
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Must stay empty: common.props sets PackageLicenseFile=LICENSE.txt for every
         packable project, and NuGet rejects a package that declares both a license
         expression and a license file (NU5035). Clearing it also makes common.props
         pack LICENSE.txt at the package root as plain content, which is what the
         other OPC UA packages do. -->
    <PackageLicenseFile></PackageLicenseFile>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The pack project carries no code and its assembly is never shipped, so
         there is nothing for the analyzers to inspect. -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Spelling intentionally matches the (misspelled) condition in common.props,
         which is the only thing that reads this property. -->
    <NoRoslynatorAnalzers>true</NoRoslynatorAnalzers>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludeSourceGeneratorAnalyzerAssets
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="@(SourceGeneratorVariant)">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="IncludeSourceGeneratorAnalyzerAssets">
    <PropertyGroup>
      <_SourceGeneratorVariantTargetFramework>netstandard2.0</_SourceGeneratorVariantTargetFramework>
      <_SourceGeneratorVariantBin>bin\$(Configuration)\$(_SourceGeneratorVariantTargetFramework)</_SourceGeneratorVariantBin>
    </PropertyGroup>
    <ItemGroup>
      <_SourceGeneratorVariantAssembly
          Include="%(SourceGeneratorVariant.RootDir)%(SourceGeneratorVariant.Directory)$(_SourceGeneratorVariantBin)\*.dll"
          Exclude="%(SourceGeneratorVariant.RootDir)%(SourceGeneratorVariant.Directory)$(_SourceGeneratorVariantBin)\Microsoft.CodeAnalysis*.dll;
                   %(SourceGeneratorVariant.RootDir)%(SourceGeneratorVariant.Directory)$(_SourceGeneratorVariantBin)\System.Collections.Immutable.dll;
                   %(SourceGeneratorVariant.RootDir)%(SourceGeneratorVariant.Directory)$(_SourceGeneratorVariantBin)\System.Reflection.Metadata.dll">
        <RoslynAnalyzerFolder>%(SourceGeneratorVariant.RoslynAnalyzerFolder)</RoslynAnalyzerFolder>
      </_SourceGeneratorVariantAssembly>
      <TfmSpecificPackageFile Include="@(_SourceGeneratorVariantAssembly)">
        <PackagePath>analyzers/dotnet/%(_SourceGeneratorVariantAssembly.RoslynAnalyzerFolder)/cs/%(_SourceGeneratorVariantAssembly.Filename)%(_SourceGeneratorVariantAssembly.Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
    <!-- Guard per variant, not over the flattened list: with N variants declared,
         an aggregate emptiness check still passes when N-1 of them produced
         nothing, which would silently ship a package missing a Roslyn band. -->
    <PropertyGroup>
      <_SourceGeneratorProducedFolders>@(_SourceGeneratorVariantAssembly->'%(RoslynAnalyzerFolder)'->Distinct(), ';')</_SourceGeneratorProducedFolders>
    </PropertyGroup>
    <ItemGroup>
      <_SourceGeneratorVariantWithoutAssets Include="@(SourceGeneratorVariant)"
          Condition="!$(_SourceGeneratorProducedFolders.Contains('%(SourceGeneratorVariant.RoslynAnalyzerFolder)'))" />
    </ItemGroup>
    <Error Condition="'@(_SourceGeneratorVariantWithoutAssets)' != ''"
           Text="No analyzer assemblies found under '$(_SourceGeneratorVariantBin)' for @(_SourceGeneratorVariantWithoutAssets->'%(Filename)', ', ') while packing $(PackageId). Build every variant project for configuration '$(Configuration)' first." />
  </Target>
</Project>
