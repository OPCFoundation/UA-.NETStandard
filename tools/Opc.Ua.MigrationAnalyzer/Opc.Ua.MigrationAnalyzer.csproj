<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Visual Studio 2026 build of the OPC UA migration analyzer, and the project
    that packs the whole migration package. The sibling
    Opc.Ua.MigrationAnalyzer.Roslyn4_8 project produces the Visual Studio 2022
    payload from the same sources.
  -->
  <!-- Already imported by Directory.Packages.props; the condition keeps this project self-contained. -->
  <Import Project="..\..\roslyn.props" Condition="'$(RoslynApiVersionVS2026)' == ''" />
  <PropertyGroup>
    <RoslynApiVersion>$(RoslynApiVersionVS2026)</RoslynApiVersion>
  </PropertyGroup>
  <!-- Package as analyzer + code-fix provider + multi-TFM shim DLLs.
       Layout is driven by Opc.Ua.MigrationAnalyzer.nuspec so we can declare the six
       OPC UA NuGet dependencies without polluting Directory.Packages.props
       (those packages are outputs of this repo, not inputs at restore time). -->
  <PropertyGroup>
    <PackageId>$(PackagePrefix).Opc.Ua.MigrationAnalyzer</PackageId>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <!-- GeneratePackageOnBuild is intentionally NOT enabled: this nuspec lays out
         multi-TFM Core (shim) DLLs that include net472/net48 heads, which only
         build on Windows. CI test jobs on Linux/macOS would otherwise fail with
         "Could not find a part of the path .../bin/Release/net472" when the
         implicit pack step runs after the analyzer build. The preview.yml
         pipeline explicitly invokes `dotnet pack` on Windows to produce the
         shippable nupkg. -->
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Nuspec-based pack can't auto-author a snupkg from project sources;
         the analyzer is shipped as a single DLL and consumers don't need symbols. -->
    <IncludeSymbols>false</IncludeSymbols>
    <NuspecFile>$(MSBuildThisFileDirectory)Opc.Ua.MigrationAnalyzer.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)</NuspecBasePath>
    <!-- NuspecProperties is materialized in _SetMigrationAnalyzerNuspecProperties below,
         after Nerdbank.GitVersioning has populated $(PackageVersion). Setting it
         here in a static PropertyGroup would capture empty version. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- The build props is referenced in the nuspec; surface it in the IDE too. -->
    <None Include="OPCFoundation.NetStandard.Opc.Ua.MigrationAnalyzer.props" Visible="false" Pack="false" />
  </ItemGroup>
  <!-- The Core (shim) project carries the multi-TFM payload that ships in the
       nuspec; we need its package restored (for transitive metadata) and we want
       NuGet to track it as a build dependency for ordering, but we do NOT want
       MSBuild's regular ProjectReference resolution to trigger a multi-TFM build
       here. Pin the negotiation to a single TFM that always exists in Core's
       $(LibTargetFrameworks):

       * Full multi-TFM build (CustomTestTarget unset)  -> net10.0
       * Per-TFM matrix entry (CustomTestTarget=<tfm>)  -> use that <tfm>, which
         is exactly the TFM Core actually builds for that matrix entry.

       SetTargetFramework bypasses NuGet's compat negotiation entirely (safe
       because ReferenceOutputAssembly=false means no compile reference flows
       through). The full multi-TFM build (needed by the nuspec) is performed
       explicitly by _BuildShimAllTfmsBeforePack during pack. -->
  <PropertyGroup>
    <!-- targets.props remaps LibTargetFrameworks=net48 when CustomTestTarget=netstandard2.0
         (the netstandard2.0 surface is exercised through the net48 head). Mirror that
         remap so the ProjectReference pin doesn't request a TFM Core never built. -->
    <_MigrationAnalyzerCorePinnedTfm Condition="'$(CustomTestTarget)' == 'netstandard2.0'">net48</_MigrationAnalyzerCorePinnedTfm>
    <_MigrationAnalyzerCorePinnedTfm Condition="'$(CustomTestTarget)' != '' AND '$(_MigrationAnalyzerCorePinnedTfm)' == ''">$(CustomTestTarget)</_MigrationAnalyzerCorePinnedTfm>
    <_MigrationAnalyzerCorePinnedTfm Condition="'$(_MigrationAnalyzerCorePinnedTfm)' == ''">net10.0</_MigrationAnalyzerCorePinnedTfm>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.MigrationAnalyzer.Core\Opc.Ua.MigrationAnalyzer.Core.csproj"
                      SetTargetFramework="TargetFramework=$(_MigrationAnalyzerCorePinnedTfm)">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <!-- Every Roslyn variant of every analyzer assembly that the nuspec ships.
       Building them here keeps the pack step independent of solution ordering. -->
  <ItemGroup>
    <MigrationAnalyzerVariantProject Include="..\Opc.Ua.MigrationAnalyzer.CodeFixer\Opc.Ua.MigrationAnalyzer.CodeFixer.csproj" />
    <MigrationAnalyzerVariantProject Include="..\Opc.Ua.MigrationAnalyzer.Generator\Opc.Ua.MigrationAnalyzer.Generator.csproj" />
  </ItemGroup>
  <!-- Ensure the multi-TFM Core (shim) DLL AND every analyzer variant are built
       before pack consumes them. The Core ProjectReference above only triggers
       a build of its single closest TFM; invoking the outer build here materializes
       every TFM under bin\$(Configuration)\<tfm>\ that the nuspec <files> entries
       reference. The analyzer variants cannot be ProjectReferences here (the
       code fixer back-references this analyzer for shared DiagnosticIds, which
       creates a NuGet restore cycle; the others have no compile dependency so a
       ProjectReference is unneeded); we invoke their builds via MSBuild tasks instead.

       Skip when NoBuild=true (i.e. `dotnet pack` with the no-build switch): in
       that flow the caller has already built every TFM via a prior `dotnet build`
       step on the containing solution (all MigrationAnalyzer projects ship
       in UA.slnx and in the generated preview-pack.slnx), so the shim outputs
       already exist on disk. Invoking Build under NoBuild=true would error
       NETSDK1085. -->
  <Target Name="_BuildShimAllTfmsBeforePack" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="..\Opc.Ua.MigrationAnalyzer.Core\Opc.Ua.MigrationAnalyzer.Core.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="@(MigrationAnalyzerVariantProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework" />
  </Target>
  <!-- Populate NuspecProperties after $(PackageVersion) is materialized (NBGV runs
       inside GetBuildVersion). Static evaluation in a PropertyGroup is too early. -->
  <Target Name="_SetMigrationAnalyzerNuspecProperties" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_MigrationAnalyzerToolsDir>$(MSBuildThisFileDirectory)..</_MigrationAnalyzerToolsDir>
      <_MigrationAnalyzerBin50>$(MSBuildThisFileDirectory)bin\$(Configuration)\netstandard2.0</_MigrationAnalyzerBin50>
      <_MigrationCodeFixerBin50>$(_MigrationAnalyzerToolsDir)\Opc.Ua.MigrationAnalyzer.CodeFixer\bin\$(Configuration)\netstandard2.0</_MigrationCodeFixerBin50>
      <_MigrationGeneratorBin50>$(_MigrationAnalyzerToolsDir)\Opc.Ua.MigrationAnalyzer.Generator\bin\$(Configuration)\netstandard2.0</_MigrationGeneratorBin50>
    </PropertyGroup>
    <PropertyGroup>
      <NuspecProperties>version=$(PackageVersion);configuration=$(Configuration);repoRoot=$(MSBuildThisFileDirectory)..\..;roslynFolderVS2026=$(RoslynAnalyzerFolderVS2026);analyzerDllVS2026=$(_MigrationAnalyzerBin50)\Opc.Ua.MigrationAnalyzer.dll;codeFixesDllVS2026=$(_MigrationCodeFixerBin50)\Opc.Ua.MigrationAnalyzer.CodeFixer.dll;generatorDllVS2026=$(_MigrationGeneratorBin50)\Opc.Ua.MigrationAnalyzer.Generator.dll;shimBin=$(MSBuildThisFileDirectory)..\Opc.Ua.MigrationAnalyzer.Core\bin\$(Configuration);readme=$(MSBuildThisFileDirectory)NugetREADME.md;propsFile=$(MSBuildThisFileDirectory)OPCFoundation.NetStandard.Opc.Ua.MigrationAnalyzer.props</NuspecProperties>
    </PropertyGroup>
  </Target>
  <Import Project="Opc.Ua.MigrationAnalyzer.Sources.targets" />
</Project>
