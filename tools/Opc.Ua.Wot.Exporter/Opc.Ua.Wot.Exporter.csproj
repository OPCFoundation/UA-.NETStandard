<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Opc.Ua.Wot.Exporter</RootNamespace>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>opcua-wot-export</ToolCommandName>
    <PackageId>$(PackagePrefix).Opc.Ua.Wot.Exporter</PackageId>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <Description>Convert OPC UA NodeSet2 files to W3C WoT Thing Models.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- A global tool has one install ID. Do not publish a second Debug tool. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\..\src\Opc.Ua.Types\Opc.Ua.Types.csproj" />
    <InternalsVisibleTo Include="Opc.Ua.Wot.Exporter.Tests" />
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
