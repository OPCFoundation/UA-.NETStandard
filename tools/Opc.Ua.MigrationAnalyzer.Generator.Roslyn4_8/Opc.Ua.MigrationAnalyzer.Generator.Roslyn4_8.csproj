<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Visual Studio 2022 build of the OPC UA migration source generator. Shares
    every source file with ..\Opc.Ua.MigrationAnalyzer.Generator through a
    glob-link, so only the Roslyn API version differs.
  -->
  <!-- Already imported by Directory.Packages.props; the condition keeps this project self-contained. -->
  <Import Project="..\RoslynVariants.props" Condition="'$(RoslynApiVersionVS2026)' == ''" />
  <PropertyGroup>
    <RoslynApiVersion>$(RoslynApiVersionVS2022)</RoslynApiVersion>
  </PropertyGroup>
  <Import Project="..\Opc.Ua.MigrationAnalyzer.Generator\Opc.Ua.MigrationAnalyzer.Generator.Sources.targets" />
</Project>
