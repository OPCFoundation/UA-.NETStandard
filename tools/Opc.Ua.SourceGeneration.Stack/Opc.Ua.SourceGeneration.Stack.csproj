<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Primary build of the OPC UA stack source generator, against the Roslyn API
    that ships with Visual Studio 2026 / the .NET 10 SDK. This is the variant
    the repository's own projects reference as an analyzer; the sibling
    Opc.Ua.SourceGeneration.Stack.Roslyn4_8 project produces the Visual Studio
    2022 payload from the same sources, and Opc.Ua.SourceGeneration.Stack.Pack
    ships both.
  -->
  <!-- Already imported by Directory.Packages.props; the condition keeps this project self-contained. -->
  <Import Project="..\..\roslyn.props" Condition="'$(RoslynApiVersionVS2026)' == ''" />
  <PropertyGroup>
    <RoslynApiVersion>$(RoslynApiVersionVS2026)</RoslynApiVersion>
  </PropertyGroup>
  <Import Project="Opc.Ua.SourceGeneration.Stack.Sources.targets" />
</Project>
