<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Sdk.props" Sdk="Aspire.AppHost.Sdk" Version="13.6.5"
          Condition="'$(CustomTestTarget)' == '' OR '$(CustomTestTarget)' == 'net10.0' OR '$(CustomTestTarget)' == 'net11.0'" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(ModernTargetFrameworks)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <IsAspireHost Condition="'$(CustomTestTarget)' == '' OR '$(CustomTestTarget)' == 'net10.0' OR '$(CustomTestTarget)' == 'net11.0'">true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <RootNamespace>UaLens.AppHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../samples/Di/PumpDeviceIntegrationServer/PumpDeviceIntegrationServer.csproj"
                      SetTargetFramework="TargetFramework=$(TargetFramework)" />
    <ProjectReference Include="../Opc.Ua.Lens/Opc.Ua.Lens.csproj"
                      SetTargetFramework="TargetFramework=$(TargetFramework)" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Aspire.AppHost.Sdk" Version="13.6.5"
          Condition="'$(CustomTestTarget)' == '' OR '$(CustomTestTarget)' == 'net10.0' OR '$(CustomTestTarget)' == 'net11.0'" />
</Project>
