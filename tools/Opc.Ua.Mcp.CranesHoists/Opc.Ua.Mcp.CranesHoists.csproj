<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Match the embedding packages; legacy solution builds restrict this project centrally. -->
    <TargetFrameworks Condition="'$(CustomTestTarget)' == ''">net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CustomTestTarget)' == 'net8.0' OR '$(CustomTestTarget)' == 'net9.0' OR '$(CustomTestTarget)' == 'net10.0'">$(CustomTestTarget)</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">$(CustomTestTarget)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <AssemblyName>$(AssemblyPrefix).Mcp.CranesHoists</AssemblyName>
    <PackageId>$(PackagePrefix).Opc.Ua.Mcp.CranesHoists</PackageId>
    <RootNamespace>Opc.Ua.Mcp</RootNamespace>
    <Description>Preview OPC 40020-1 Cranes and Hoists MCP tools for bounded inventory, monitoring and explicitly authorized standard limit configuration, using the typed crane client and shared OPC UA sessions.</Description>
    <Company>OPC Foundation</Company>
    <Copyright>Copyright © 2004-2026 OPC Foundation, Inc</Copyright>
    <PackageTags>OPCFoundation OPC UA MCP ModelContextProtocol Cranes Hoists</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageId>$(PackageId).Debug</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Tools.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opc.Ua.Mcp.Core\Opc.Ua.Mcp.Core.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.CranesHoists.Client\Opc.Ua.CranesHoists.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
