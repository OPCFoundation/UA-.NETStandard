<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Visual Studio 2026 build of the OPC UA migration code-fix providers, and the
    variant the repository's own test project references. The sibling
    Opc.Ua.MigrationAnalyzer.CodeFixer.Roslyn4_8 project produces the Visual
    Studio 2022 payload from the same sources.
  -->
  <!-- Already imported by Directory.Packages.props; the condition keeps this project self-contained. -->
  <Import Project="..\..\roslyn.props" Condition="'$(RoslynApiVersionVS2026)' == ''" />
  <PropertyGroup>
    <RoslynApiVersion>$(RoslynApiVersionVS2026)</RoslynApiVersion>
    <!-- This is a non-packable project: its DLL is consumed by the parent
         Opc.Ua.MigrationAnalyzer package via a path reference in the nuspec. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="Opc.Ua.MigrationAnalyzer.CodeFixer.Sources.targets" />
</Project>
