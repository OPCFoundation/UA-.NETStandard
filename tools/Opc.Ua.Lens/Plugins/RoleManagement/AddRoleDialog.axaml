<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.RoleManagement.AddRoleDialog"
        Title="Add role"
        Width="520" Height="240"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16" LastChildFill="True">

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="Add" IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
              Width="100" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock x:Name="ErrorLabel" DockPanel.Dock="Bottom"
               Foreground="{DynamicResource ErrorText}"
               Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 TextWrapping="Wrap"
                 Text="Add a new role to the server's RoleSet. The role name is required; the namespace URI is optional (defaults to the server's own namespace)." />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="k" Text="Role name *" />
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="NameBox" PlaceholderText="e.g. Observer" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="k" Text="Namespace URI" Margin="0,8,0,0" />
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="NamespaceBox" Margin="0,8,0,0"
                 PlaceholderText="(blank → server default)" />
    </Grid>
  </DockPanel>
</Window>
