<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.RoleManagement.AddIdentityDialog"
        Title="Add identity mapping"
        Width="560" Height="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16" LastChildFill="True">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="Add" IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
              Width="100" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock x:Name="ErrorLabel" DockPanel.Dock="Bottom"
               Foreground="{DynamicResource ErrorText}"
               Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 TextWrapping="Wrap"
                 Text="Add an identity-mapping rule to the role. The criteria type selects which authentication facet the criteria string matches against (per OPC UA Part 18 §4.4.4)." />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="k" Text="Criteria type *" />
      <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CriteriaTypeBox"
                 HorizontalAlignment="Stretch" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="k" Text="Criteria" Margin="0,8,0,0" />
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="CriteriaBox" Margin="0,8,0,0"
                 PlaceholderText="(value depends on Criteria type — e.g. alice, CN=Bob, MyGroup)" />
    </Grid>
  </DockPanel>
</Window>
