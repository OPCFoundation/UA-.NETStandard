<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.RoleManagement.AddApplicationUriDialog"
        Title="Add application URI"
        Width="520" Height="200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16" LastChildFill="True">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="Add" IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
              Width="100" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock x:Name="ErrorLabel" DockPanel.Dock="Bottom"
               Foreground="{DynamicResource ErrorText}"
               Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto">

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                 Margin="0,0,0,12"
                 TextWrapping="Wrap"
                 Text="Add an Application URI to the role's Applications list. The value matches against the ApplicationUri reported by the calling client." />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="k" Text="Application URI *" />
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="UriBox"
                 PlaceholderText="urn:hostname:product" />
    </Grid>
  </DockPanel>
</Window>
