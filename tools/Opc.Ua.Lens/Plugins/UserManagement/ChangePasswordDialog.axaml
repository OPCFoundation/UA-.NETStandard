<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.UserManagement.ChangePasswordDialog"
        Title="Change password"
        Width="460" Height="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16" LastChildFill="True">

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton"     Content="Change" IsDefault="True" Width="100" IsEnabled="False" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock x:Name="ErrorLabel" DockPanel.Dock="Bottom"
               Foreground="{DynamicResource ErrorText}"
               Margin="0,8,0,0" IsVisible="False" TextWrapping="Wrap" />

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="160,*">
      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" TextWrapping="Wrap"
                 Text="Change password for the current session user (Part 18 §5.2.6 ChangePassword)." />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="k" Text="Current password *" />
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OldPasswordBox"     PasswordChar="●" Margin="0,0,0,8" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="k" Text="New password *" />
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="NewPasswordBox"     PasswordChar="●" Margin="0,0,0,8" />

      <TextBlock Grid.Row="3" Grid.Column="0" Classes="k" Text="Confirm new password *" />
      <TextBox   Grid.Row="3" Grid.Column="1" x:Name="ConfirmPasswordBox" PasswordChar="●" Margin="0,0,0,8" />
    </Grid>
  </DockPanel>
</Window>
