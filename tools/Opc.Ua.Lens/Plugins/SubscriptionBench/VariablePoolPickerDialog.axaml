<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:UaLens.Plugins.SubscriptionBench"
        x:Class="UaLens.Plugins.SubscriptionBench.VariablePoolPickerDialog"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
    <TextBlock Grid.Row="0"
               x:Name="HeaderLabel"
               Margin="0,0,0,8"
               TextWrapping="Wrap" />

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
      <CheckBox Grid.Column="0"
                x:Name="SelectAllCheck"
                Content="Select all (visible)"
                VerticalAlignment="Center" />
      <TextBlock Grid.Column="2"
                 x:Name="SelectionLabel"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondary}"
                 FontSize="11" />
    </Grid>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4"
            Background="{DynamicResource PanelBg}">
      <ListBox x:Name="ResultsList"
               Background="Transparent" Foreground="{DynamicResource TextPrimary}"
               BorderThickness="0"
               SelectionMode="Multiple,Toggle">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="v:VariablePoolPickerItem">
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox Grid.Column="0"
                        VerticalAlignment="Center"
                        IsChecked="{CompiledBinding IsSelected, Mode=TwoWay}" />
              <TextBlock Grid.Column="1"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         Text="{CompiledBinding BrowsePath}"
                         FontFamily="Cascadia Mono, Consolas, monospace"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TextBlock Grid.Row="3"
               x:Name="StatusLabel"
               Margin="0,8,0,4"
               Foreground="{DynamicResource TextSecondary}"
               FontSize="11" />
    <ProgressBar Grid.Row="4" x:Name="Progress" Height="6"
                 IsIndeterminate="True" Minimum="0" Maximum="100" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
