<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:vm="using:UaLens.Plugins.Performance"
             x:Class="UaLens.Plugins.Performance.PerformanceView"
             x:DataType="vm:PerformancePlugin">
  <UserControl.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.statDim">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.runRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="Border.runRow.highlight">
      <Setter Property="Background" Value="{DynamicResource HighlightBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
      <Setter Property="BorderThickness" Value="2,0,0,1" />
    </Style>
    <Style Selector="Border.runRow.baseline">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}" />
      <Setter Property="BorderThickness" Value="3,0,0,1" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="10">
    <Grid RowDefinitions="Auto,*">

      <!-- Row 0: action toolbar (WrapPanel — wraps on narrow windows) -->
      <Border Grid.Row="0" Padding="10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,Auto">
          <WrapPanel Classes="toolbar" Grid.Row="0" Orientation="Horizontal" ItemHeight="32">
            <ComboBox x:Name="ModeCombo" Margin="0,0,6,0"
                      ItemsSource="{CompiledBinding ModeOptions}"
                      SelectedItem="{CompiledBinding Mode, Mode=TwoWay}"
                      IsEnabled="{CompiledBinding ConfigurationEditable}"
                      MinWidth="100" VerticalAlignment="Center" />
            <Button Classes="quiet" Content="Pick target…" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Command="{CompiledBinding PickTargetCommand}" />
            <Button Classes="primary" Content="Run"  Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Command="{CompiledBinding RunCommand}" />
            <Button Content="Stop" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Stop the running workload."
                    Command="{CompiledBinding StopCommand}" />
            <Button Classes="quiet"   Content="Reset" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Command="{CompiledBinding ResetCommand}" />
            <Button Classes="quiet"   Content="Save…" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Save comparison JSON with evidence and buckets, or aggregate-only legacy CSV."
                    Command="{CompiledBinding SaveResultsCommand}" />
            <Button Classes="quiet"   Content="Load…" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Load comparison JSON or legacy CSV. This never starts or configures a workload."
                    Command="{CompiledBinding LoadResultsCommand}" />
            <Button Classes="quiet"   Content="Settings…"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Open the workload editor (rate / duration / value generator)."
                    Command="{CompiledBinding OpenSettingsDialogCommand}" />
          </WrapPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Classes="h" Text="TARGET" VerticalAlignment="Center" />
            <TextBlock Classes="statDim" VerticalAlignment="Center"
                       Text="{CompiledBinding TargetNodeIdText}"
                       ToolTip.Tip="{CompiledBinding TargetDescription}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="statDim" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="·" />
            <TextBlock Classes="statDim" VerticalAlignment="Center"
                       Text="{CompiledBinding TargetDescription}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="420" />
            <TextBlock Classes="statDim" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="·" />
            <TextBlock Classes="statDim" VerticalAlignment="Center"
                       Text="{CompiledBinding EffectiveDurationText, StringFormat='duration={0}'}" />
            <TextBlock Classes="statDim" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="·" />
            <TextBlock Classes="statDim" VerticalAlignment="Center"
                       Text="{CompiledBinding ConcurrencyHint}" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Row="1" Margin="0,8,0,0">
        <TabItem Header="Live run">
          <Grid RowDefinitions="Auto,*,*,Auto">
      <TextBlock Grid.Row="0" Classes="h" Margin="2,10,2,4"
                 Text="THROUGHPUT — rolling 60 s window (ops/sec)" />

      <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
        <ScottPlot:AvaPlot x:Name="ThroughputPlot" />
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Classes="h" Margin="8,6,0,0"
                     Text="LATENCY - observed log buckets; overflow >= 10 s; lines mark p50 / p95 / p99 estimates" />
          <ScottPlot:AvaPlot Grid.Row="1" x:Name="HistogramPlot" />
        </Grid>
      </Border>

      <Border Grid.Row="3" Padding="8,6" Margin="0,8,0,0"
              Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="4">
        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
          <StackPanel Grid.Column="0" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="TOTAL OPS" />
            <TextBlock Classes="stat" Text="{CompiledBinding TotalOpsText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="MEAN OPS/S" />
            <TextBlock Classes="stat" Text="{CompiledBinding MeanRateText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="p50 (ms)" />
            <TextBlock Classes="stat" Text="{CompiledBinding P50Text}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="p95 (ms)" />
            <TextBlock Classes="stat" Text="{CompiledBinding P95Text}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="p99 (ms)" />
            <TextBlock Classes="stat" Text="{CompiledBinding P99Text}" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="MAX (ms)" />
            <TextBlock Classes="stat" Text="{CompiledBinding MaxLatencyText}" />
          </StackPanel>
          <StackPanel Grid.Column="6" Orientation="Vertical">
            <TextBlock Classes="statDim" Text="ERRORS" />
            <TextBlock Classes="stat" Text="{CompiledBinding ErrorsText}" />
          </StackPanel>
        </Grid>
      </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Compare runs">
          <Grid RowDefinitions="Auto,Auto,180,*" Margin="4,8,4,0">
            <StackPanel Grid.Row="0" Spacing="6">
              <WrapPanel Orientation="Horizontal">
                <Button Content="Use as baseline" Margin="0,0,6,0"
                        Command="{CompiledBinding History.UseSelectedAsBaselineCommand}" />
                <Button Content="Clear baseline" Margin="0,0,12,0"
                        Command="{CompiledBinding History.ClearBaselineCommand}" />
                <CheckBox Content="Highlight latest 3 (only)"
                          IsChecked="{CompiledBinding CompareLast3, Mode=TwoWay}" />
              </WrapPanel>
              <TextBlock Classes="stat" Text="{CompiledBinding History.BaselineText, StringFormat='Baseline: {0}'}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Row="1" Classes="statDim" Margin="0,6"
                       Text="{CompiledBinding History.Status}" TextWrapping="Wrap" />
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
              <TextBlock Classes="h"
                         Text="RUNS - newest first, up to 64; select a row to compare with the chosen baseline" />
              <ListBox Grid.Row="1" x:Name="HistoryList"
                       ItemsSource="{CompiledBinding RunHistory}"
                       SelectedItem="{CompiledBinding History.SelectedRun, Mode=TwoWay}"
                       Background="{DynamicResource AppBg}"
                       BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BenchmarkRunRow">
                    <Border Classes="runRow" Classes.highlight="{CompiledBinding IsHighlighted}"
                            Classes.baseline="{CompiledBinding IsBaseline}" ToolTip.Tip="{CompiledBinding Run.Notes}">
                      <Grid ColumnDefinitions="44,170,95,100,100,80,80,85">
                        <TextBlock Grid.Column="0" Classes="statDim" Text="BASE"
                                   IsVisible="{CompiledBinding IsBaseline}" />
                        <TextBlock Grid.Column="1" Classes="stat" Text="{CompiledBinding TimestampDisplay}" />
                        <TextBlock Grid.Column="2" Classes="statDim" TextAlignment="Right"
                                   Text="{CompiledBinding TargetRateDisplay, StringFormat='target {0}'}" />
                        <TextBlock Grid.Column="3" Classes="stat" TextAlignment="Right"
                                   Text="{CompiledBinding AchievedRateDisplay, StringFormat='{}{0} ops/s'}" />
                        <TextBlock Grid.Column="4" Classes="statDim" TextAlignment="Right"
                                   Text="{CompiledBinding TotalOpsDisplay, StringFormat='{}{0} ops'}" />
                        <TextBlock Grid.Column="5" Classes="statDim" TextAlignment="Right"
                                   Text="{CompiledBinding P50Display, StringFormat='p50 {0}'}" />
                        <TextBlock Grid.Column="6" Classes="statDim" TextAlignment="Right"
                                   Text="{CompiledBinding P99Display, StringFormat='p99 {0}'}" />
                        <TextBlock Grid.Column="7" Classes="statDim" TextAlignment="Right"
                                   Text="{CompiledBinding ErrorCountDisplay, StringFormat='{}{0} errors'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <ContentControl Grid.Row="3" Content="{CompiledBinding History.Comparison}"
                            IsVisible="{CompiledBinding History.HasComparison}" Margin="0,8,0,0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:BenchmarkComparison">
                  <TabControl>
                    <TabItem Header="Metrics">
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" Margin="4,8">
                          <TextBlock Classes="statDim" Text="{CompiledBinding MetricCaveat}"
                                     TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                          <Grid ColumnDefinitions="200,140,140,160,190">
                            <TextBlock Classes="h" Text="METRIC" />
                            <TextBlock Grid.Column="1" Classes="h" Text="BASELINE" />
                            <TextBlock Grid.Column="2" Classes="h" Text="SELECTED" />
                            <TextBlock Grid.Column="3" Classes="h" Text="ABSOLUTE DELTA" />
                            <TextBlock Grid.Column="4" Classes="h" Text="RELATIVE DELTA" />
                          </Grid>
                          <ItemsControl ItemsSource="{CompiledBinding MetricRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:BenchmarkMetricRow">
                                <Grid ColumnDefinitions="200,140,140,160,190" Margin="0,3">
                                  <TextBlock Classes="stat" Text="{CompiledBinding Metric}" />
                                  <TextBlock Grid.Column="1" Classes="stat" Text="{CompiledBinding BaselineText}" />
                                  <TextBlock Grid.Column="2" Classes="stat" Text="{CompiledBinding SelectedText}" />
                                  <TextBlock Grid.Column="3" Classes="stat" Text="{CompiledBinding AbsoluteText}" />
                                  <TextBlock Grid.Column="4" Classes="stat" Text="{CompiledBinding RelativeText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Comparability evidence">
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" Margin="4,8">
                          <Grid ColumnDefinitions="190,320,320,85">
                            <TextBlock Classes="h" Text="EVIDENCE" />
                            <TextBlock Grid.Column="1" Classes="h" Text="BASELINE" />
                            <TextBlock Grid.Column="2" Classes="h" Text="SELECTED" />
                            <TextBlock Grid.Column="3" Classes="h" Text="STATUS" />
                          </Grid>
                          <ItemsControl ItemsSource="{CompiledBinding EvidenceRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:BenchmarkEvidence">
                                <Grid ColumnDefinitions="190,320,320,85" Margin="0,3">
                                  <TextBlock Classes="stat" Text="{CompiledBinding Criterion}" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="1" Classes="statDim" Margin="0,0,8,0"
                                             Text="{CompiledBinding BaselineText}" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="2" Classes="statDim" Margin="0,0,8,0"
                                             Text="{CompiledBinding SelectedText}" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="3" Classes="stat" Text="{CompiledBinding StatusText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Observed distributions">
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" Margin="4,8">
                          <TextBlock Classes="statDim" Text="{CompiledBinding DistributionStatus}"
                                     TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                          <TextBlock Classes="statDim" MaxWidth="900" TextWrapping="Wrap"
                                     HorizontalAlignment="Left"
                                     Text="Observed buckets only, including errored operations. Empty bins are omitted. Percentages use each run's own sample count; pp means percentage points." />
                          <Grid ColumnDefinitions="230,120,120,110,110,110">
                            <TextBlock Classes="h" Text="LATENCY [LOWER, UPPER)" />
                            <TextBlock Grid.Column="1" Classes="h" Text="BASELINE COUNT" />
                            <TextBlock Grid.Column="2" Classes="h" Text="SELECTED COUNT" />
                            <TextBlock Grid.Column="3" Classes="h" Text="BASELINE %" />
                            <TextBlock Grid.Column="4" Classes="h" Text="SELECTED %" />
                            <TextBlock Grid.Column="5" Classes="h" Text="CHANGE (pp)" />
                          </Grid>
                          <ItemsControl ItemsSource="{CompiledBinding DistributionRows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:BenchmarkDistributionRow">
                                <Grid ColumnDefinitions="230,120,120,110,110,110" Margin="0,3">
                                  <TextBlock Classes="stat" Text="{CompiledBinding BucketText}" />
                                  <TextBlock Grid.Column="1" Classes="stat"
                                             Text="{CompiledBinding BaselineCountText}" />
                                  <TextBlock Grid.Column="2" Classes="stat"
                                             Text="{CompiledBinding SelectedCountText}" />
                                  <TextBlock Grid.Column="3" Classes="stat"
                                             Text="{CompiledBinding BaselinePercentText}" />
                                  <TextBlock Grid.Column="4" Classes="stat"
                                             Text="{CompiledBinding SelectedPercentText}" />
                                  <TextBlock Grid.Column="5" Classes="stat" Text="{CompiledBinding DeltaText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>
                  </TabControl>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</UserControl>
