<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UaLens.Plugins.Companions"
             xmlns:providers="using:UaLens.Plugins.Companions.Providers"
             x:Class="UaLens.Plugins.Companions.CompanionView"
             x:DataType="vm:CompanionPlugin"
             Background="{DynamicResource SurfaceBg}"
             Foreground="{DynamicResource TextPrimary}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <WrapPanel Orientation="Horizontal">
        <ComboBox ItemsSource="{CompiledBinding Providers}"
                  SelectedItem="{CompiledBinding SelectedProvider, Mode=TwoWay}"
                  IsVisible="{CompiledBinding ShowProviderPicker}"
                  IsEnabled="{CompiledBinding !IsBusy}"
                  MinWidth="220" Margin="0,0,8,0"
                  AutomationProperties.Name="Companion model">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:CompanionDescriptor">
              <TextBlock Text="{CompiledBinding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Discover" Command="{CompiledBinding DiscoverCommand}" Margin="0,0,8,0" />
        <Button Content="Inspect" Command="{CompiledBinding InspectCommand}" Margin="0,0,8,0" />
        <Button Content="Stop" Command="{CompiledBinding CancelCommand}" IsEnabled="{CompiledBinding IsBusy}" />
        <Button Content="Conditions..." Command="{CompiledBinding OpenAlarmsCommand}" Margin="8,0,0,0" />
        <Button Content="PackML..." Command="{CompiledBinding OpenPackMlCommand}"
                IsVisible="{CompiledBinding ShowPackMlAction}" Margin="8,0,0,0" />
      </WrapPanel>
      <TextBlock Text="{CompiledBinding SelectedProvider.Maturity}" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondary}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{CompiledBinding IsBusy}" Height="2" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{CompiledBinding Status}" TextWrapping="Wrap"
               Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}" />
    <Grid ColumnDefinitions="2*,5,3*">
      <ListBox Grid.Column="0" ItemsSource="{CompiledBinding Targets}"
               SelectedItem="{CompiledBinding SelectedTarget, Mode=TwoWay}"
               IsEnabled="{CompiledBinding !IsBusy}"
               Background="{DynamicResource PanelBg}"
               AutomationProperties.Name="Companion instances">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CompanionTarget">
            <StackPanel Spacing="3" Margin="4">
              <TextBlock Text="{CompiledBinding DisplayName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{CompiledBinding TypeName}" FontSize="11"
                         Foreground="{DynamicResource TextSecondary}" />
              <TextBlock Text="{CompiledBinding Identifier}" FontSize="11" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" Background="{DynamicResource SeparatorBrush}" />
      <DockPanel Grid.Column="2" Margin="12,0,0,0">
        <Border DockPanel.Dock="Top" IsVisible="{CompiledBinding ShowViewport}" Margin="0,0,0,8">
          <StackPanel Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="Embedded OpenUSD / simulated Vision" FontWeight="SemiBold" />
            <WrapPanel>
              <Button Content="Start viewport" Command="{CompiledBinding StartViewportCommand}"
                      Margin="0,0,8,4" AutomationProperties.Name="Start embedded OpenUSD viewport" />
              <Button Content="Stop viewport" Command="{CompiledBinding StopViewportCommand}"
                      Margin="0,0,8,4" AutomationProperties.Name="Stop embedded OpenUSD viewport" />
              <Button Content="Capture rendered frame" Command="{CompiledBinding CaptureViewportFrameCommand}"
                      Margin="0,0,8,4" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{CompiledBinding HasViewport}">
              <TextBox Text="{CompiledBinding ViewportCameraPath, Mode=TwoWay}" MaxLength="512"
                       PlaceholderText="Camera prim path; empty uses automatic framing"
                       AutomationProperties.Name="OpenUSD camera prim path" />
              <Button Grid.Column="1" Content="Use camera" Command="{CompiledBinding ApplyViewportCameraCommand}"
                      Margin="8,0,0,0" />
            </Grid>
            <Border IsVisible="{CompiledBinding HasViewport}" Height="320" MinWidth="200"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="1" ClipToBounds="True">
              <ContentControl Content="{CompiledBinding ViewportSurface}" HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              AutomationProperties.Name="Retained OpenUSD composition surface" />
            </Border>
            <TextBlock Text="{CompiledBinding SelectedUsdPrim}" TextWrapping="Wrap"
                       AutomationProperties.Name="Selected USD prim" />
            <WrapPanel IsVisible="{CompiledBinding HasViewport}">
              <Button Content="Discover simulated cameras" Command="{CompiledBinding DiscoverSimulatedCamerasCommand}"
                      Margin="0,0,8,4" />
              <Button Content="Render simulated Vision" Command="{CompiledBinding RenderSimulatedVisionCommand}"
                      Margin="0,0,0,4" />
            </WrapPanel>
            <ComboBox ItemsSource="{CompiledBinding SimulatedCameras}"
                      SelectedItem="{CompiledBinding SelectedSimulatedCamera, Mode=TwoWay}"
                      IsVisible="{CompiledBinding HasViewport}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Simulated Vision camera">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="providers:RenderedVisionCamera">
                  <TextBlock Text="{CompiledBinding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock IsVisible="{CompiledBinding HasViewport}" TextWrapping="Wrap" FontSize="11"
                       Text="Render maps the selected sensor camera into this captured scene. Its advertised stage below is evidence only: no URI is opened, no server acquisition or inference is started." />
            <TextBlock Text="{CompiledBinding SelectedSimulatedCamera.StageIdentifier}" TextWrapping="Wrap"
                       FontSize="11" AutomationProperties.Name="Advertised simulated stage identity" />
            <Image Source="{CompiledBinding RenderedVisionFrame}" MaxHeight="200" Stretch="Uniform"
                   AutomationProperties.Name="Rendered Vision frame" />
            <TextBlock Text="{CompiledBinding ViewportStatus}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       AutomationProperties.Name="Embedded viewport status" />
          </StackPanel>
        </Border>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button Content="Monitor selected value" Command="{CompiledBinding OpenMonitorCommand}"
                  Margin="0,0,8,4" />
          <Button Content="History..." Command="{CompiledBinding OpenHistoryCommand}" Margin="0,0,8,4" />
          <Button Content="Export displayed values..." Command="{CompiledBinding ExportSnapshotCommand}"
                  Margin="0,0,0,4" />
        </WrapPanel>
        <Expander DockPanel.Dock="Bottom" Header="Guided operations" IsExpanded="False" Margin="0,8,0,0">
          <StackPanel Spacing="8" Margin="0,8,0,0" IsEnabled="{CompiledBinding !IsBusy}">
            <TextBlock Text="Inspect an instance to see its available operations." TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
            <ComboBox ItemsSource="{CompiledBinding Operations}"
                      SelectedItem="{CompiledBinding SelectedOperation, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Guided operation">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:CompanionOperation">
                  <TextBlock Text="{CompiledBinding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{CompiledBinding OperationInput, Mode=TwoWay}"
                     IsVisible="{CompiledBinding !SelectedOperation.HasTypedInput}"
                     PlaceholderText="{CompiledBinding SelectedOperation.InputHint}"
                     MaxLength="65536" AutomationProperties.Name="Operation input or destination" />
            <ItemsControl ItemsSource="{CompiledBinding InputFields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CompanionInputEditor">
                  <StackPanel Spacing="4" Margin="0,0,0,8">
                    <TextBlock Text="{CompiledBinding Definition.DisplayName}" TextWrapping="Wrap" />
                    <TextBox Text="{CompiledBinding Text, Mode=TwoWay}"
                             IsVisible="{CompiledBinding IsText}"
                             AcceptsReturn="{CompiledBinding Definition.IsMultiline}"
                             MaxHeight="120" TextWrapping="Wrap"
                             PlaceholderText="{CompiledBinding Definition.Hint}" MaxLength="65536"
                             AutomationProperties.Name="{CompiledBinding Definition.DisplayName}" />
                    <CheckBox IsChecked="{CompiledBinding Checked, Mode=TwoWay}"
                              IsVisible="{CompiledBinding IsBoolean}"
                              Content="{CompiledBinding Definition.Hint}" />
                    <Button Content="Choose local file..." Command="{CompiledBinding PickFileCommand}"
                            IsVisible="{CompiledBinding Definition.IsFileSource}"
                            HorizontalAlignment="Left" />
                    <Button Content="Edit typed value..." Command="{CompiledBinding EditCommand}"
                            IsVisible="{CompiledBinding RequiresEditor}" HorizontalAlignment="Left" />
                    <CheckBox IsChecked="{CompiledBinding Omitted, Mode=TwoWay}"
                              IsVisible="{CompiledBinding CanOmit}" Content="Omit optional structure"
                              AutomationProperties.Name="Omit optional companion input" />
                    <TextBlock Text="{CompiledBinding TypedSummary}" TextWrapping="Wrap"
                               IsVisible="{CompiledBinding RequiresEditor}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Prepare selected task" Command="{CompiledBinding PrepareTaskCommand}"
                    HorizontalAlignment="Left" AutomationProperties.Name="Prepare companion task" />
            <TextBlock Text="{CompiledBinding PreparationSummary}" TextWrapping="Wrap"
                       AutomationProperties.Name="Companion task preflight" />
            <CheckBox IsChecked="{CompiledBinding ConfirmLocalSample, Mode=TwoWay}"
                      IsVisible="{CompiledBinding !IsDeploymentOperation}"
                      Content="I confirm this loopback server is a repository sample." />
            <CheckBox IsChecked="{CompiledBinding ConfirmDeployment, Mode=TwoWay}"
                      IsVisible="{CompiledBinding IsDeploymentOperation}"
                      Content="I authorize this prepared deployment operation under the displayed rule."
                      AutomationProperties.Name="Confirm deployment operation" />
            <TextBlock Text="Mutations can change server state. Prepare first, then confirm for this execution. Deployment operations also require a matching configured rule. Preparation and confirmation are never saved."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
            <Button Content="Run selected task" Command="{CompiledBinding RunTaskCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ListBox ItemsSource="{CompiledBinding Values}"
                   SelectedItem="{CompiledBinding SelectedValue, Mode=TwoWay}"
                   AutomationProperties.Name="Inspected source values">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:CompanionValue">
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="{CompiledBinding Name}" Margin="0,5,8,0"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                  <TextBox Grid.Column="1" Text="{CompiledBinding Text, Mode=OneWay}"
                           IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                           Background="Transparent" BorderThickness="0"
                           AutomationProperties.Name="{CompiledBinding Name}" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{CompiledBinding Evidence}"
                             TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
