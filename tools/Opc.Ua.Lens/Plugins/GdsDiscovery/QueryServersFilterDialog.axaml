<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.GdsDiscovery.QueryServersFilterDialog"
        Title="QueryServers filter"
        Width="500" Height="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
        ColumnDefinitions="*">
    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Filters applied to QueryServersAsync against the GDS. Empty fields are wildcards." />

    <TextBlock Grid.Row="1" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,2"
               Text="Application name" />
    <TextBox  Grid.Row="2" x:Name="AppNameBox" />

    <TextBlock Grid.Row="3" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,2"
               Text="Application URI" />
    <TextBox  Grid.Row="4" x:Name="AppUriBox" />

    <TextBlock Grid.Row="5" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,2"
               Text="Product URI" />
    <TextBox  Grid.Row="6" x:Name="ProductUriBox" />

    <TextBlock Grid.Row="7" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,2"
               Text="Server capabilities (comma-separated, e.g. 'DA, HA, LiveData')" />
    <TextBox  Grid.Row="8" x:Name="CapabilitiesBox" />

    <StackPanel Grid.Row="10" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
