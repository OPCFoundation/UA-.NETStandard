<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.FileSystem.FilterDialog"
        Title="FileSystem settings"
        Width="400" Height="240"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="*">
    <TextBlock Grid.Row="0" Margin="0,0,0,10"
               TextWrapping="Wrap"
               Text="Restrict which kinds of node the next 'Pick root…' dialog will accept as a FileSystem tree root." />

    <CheckBox Grid.Row="1" x:Name="AcceptFileSystemBox"
              Content="FileSystem (Server.FileSystem and FileSystemType instances)"
              Margin="0,2" />
    <CheckBox Grid.Row="2" x:Name="AcceptDirectoryBox"
              Content="FileDirectoryType (directories)"
              Margin="0,2" />
    <CheckBox Grid.Row="3" x:Name="AcceptFileBox"
              Content="FileType (individual files)"
              Margin="0,2" />

    <TextBlock Grid.Row="4" Margin="0,12,0,0"
               Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
               Text="Tip: picking a FileType opens the file's containing directory as the root with only that file visible." />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
