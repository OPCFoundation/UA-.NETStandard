<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.FileSystem.NameInputDialog"
        Width="420" Height="170"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">
    <TextBlock Grid.Row="0" x:Name="PromptLabel"
               Margin="0,0,0,8" TextWrapping="Wrap" />
    <TextBox  Grid.Row="1" x:Name="NameBox"
              AutomationProperties.LabeledBy="{Binding #PromptLabel}"
              Margin="0,0,0,4" />
    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
