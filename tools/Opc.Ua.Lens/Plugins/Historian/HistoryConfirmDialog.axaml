<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Plugins.Historian.HistoryConfirmDialog"
        Title="Confirm history change"
        Width="500" Height="210"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <DockPanel Margin="16" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="Apply" IsDefault="True" Width="140"
              Background="{DynamicResource AccentRed}" Foreground="{DynamicResource AppBg}"
              FontWeight="SemiBold" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
              Width="100" Margin="8,0,0,0" />
    </StackPanel>
    <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" VerticalAlignment="Top" />
  </DockPanel>
</Window>
