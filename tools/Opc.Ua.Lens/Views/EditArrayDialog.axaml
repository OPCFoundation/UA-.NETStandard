<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Views.EditArrayDialog"
        Title="Edit array"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <TextBlock Grid.Row="0" x:Name="HeaderLabel"
               FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" x:Name="HintLabel"
               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />

    <ListBox Grid.Row="2" x:Name="ItemsList"
             FontFamily="Cascadia Mono, Consolas, monospace"
             SelectionMode="Single" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
      <Button x:Name="AddButton"    Content="Add"    Width="80" />
      <Button x:Name="EditButton"   Content="Edit…"  Width="80" />
      <Button x:Name="RemoveButton" Content="Remove" Width="80" />
      <Button x:Name="MoveUpButton" Content="↑"      Width="40" />
      <Button x:Name="MoveDownButton" Content="↓"    Width="40" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
