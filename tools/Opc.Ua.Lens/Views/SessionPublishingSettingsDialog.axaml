<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Views.SessionPublishingSettingsDialog"
        Title="Connection publishing pipeline" Width="500" Height="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,130">
    <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,16">
      <TextBlock.Text>
        These limits belong to the connection and affect every monitor and benchmark subscription.
        V2 uses the same limits for publish workers.
      </TextBlock.Text>
    </TextBlock>
    <TextBlock Grid.Row="1" Text="Minimum outstanding requests" VerticalAlignment="Center" />
    <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="MinimumRequests" Minimum="1" Maximum="10000" />
    <TextBlock Grid.Row="2" Text="Maximum outstanding requests" VerticalAlignment="Center" Margin="0,10,0,0" />
    <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="MaximumRequests"
                   Minimum="1" Maximum="10000" Margin="0,10,0,0" />
    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="ValidationError" TextWrapping="Wrap"
               Foreground="{DynamicResource AccentRed}" Margin="0,12,0,0" />
    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="ApplyButton" Content="Apply to connection" Classes="primary" IsDefault="True" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
