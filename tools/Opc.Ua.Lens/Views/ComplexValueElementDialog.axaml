<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:UaLens.Views"
        x:Class="UaLens.Views.ComplexValueElementDialog"
        Title="Edit structured value"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="*,Auto,Auto">
    <v:ComplexValueEditor x:Name="Editor" />

    <TextBlock Grid.Row="1" x:Name="StatusLabel"
               FontFamily="Cascadia Mono, Consolas, monospace"
               TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
