<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Views.AboutDialog"
        Title="About UaLens"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Inter, Segoe UI, sans-serif">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">

    <!-- Header: icon + product info -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <Image Grid.Column="0"
             Width="64" Height="64"
             VerticalAlignment="Top"
             Source="avares://UaLens/Assets/app-icon.png" />
      <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2">
        <TextBlock Text="UaLens"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="Multi-tab Avalonia desktop client for OPC UA"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        <TextBlock x:Name="VersionLabel"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,6,0,0" />
        <TextBlock Text="Copyright © 2005-2026, OPC Federation AISBL"
                   FontSize="12" Foreground="{DynamicResource TextSecondary}" />
      </StackPanel>
    </Grid>

    <!-- License body -->
    <TextBox Grid.Row="1"
             x:Name="LicenseBox"
             AcceptsReturn="True"
             IsReadOnly="True"
             TextWrapping="Wrap"
             FontFamily="Cascadia Mono, Consolas, monospace"
             FontSize="11"
             Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextSecondaryAlt}"
             BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" />

    <!-- Bottom-right action buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="WebsiteButton" Content="Visit website"
              Padding="12,6" MinWidth="120"
              Background="{DynamicResource SeparatorBrush}" Foreground="{DynamicResource TextPrimary}" />
      <Button x:Name="CloseButton" Content="Close"
              IsCancel="True" IsDefault="True"
              Padding="12,6" MinWidth="100"
              Background="{DynamicResource AccentBlue}" Foreground="{DynamicResource AppBg}" FontWeight="SemiBold" />
    </StackPanel>
  </Grid>
</Window>
