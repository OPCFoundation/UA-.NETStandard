<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UaLens.Views.ComplexValueEditor">
  <Grid RowDefinitions="Auto,Auto,*">
    <TextBlock Grid.Row="0" x:Name="HeaderLabel"
               FontWeight="SemiBold" Foreground="{DynamicResource InfoText}"
               Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" x:Name="HintLabel"
               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" TextWrapping="Wrap" />
    <Border Grid.Row="2" BorderBrush="{DynamicResource ToolbarBg}" BorderThickness="1" CornerRadius="4">
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" Padding="6">
        <StackPanel x:Name="BodyPanel" Spacing="4" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
