<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Views.PrimitiveValuePromptDialog"
        Title="Edit value"
        Width="480" Height="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*">
    <TextBlock Grid.Row="0" x:Name="HeaderLabel"
               FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" x:Name="HintLabel"
               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />
    <TextBox Grid.Row="2" x:Name="ValueText"
             AutomationProperties.LabeledBy="{Binding #HeaderLabel}"
             FontFamily="Cascadia Mono, Consolas, monospace" />
    <TextBlock Grid.Row="3" x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,40,0,0">
      <Button x:Name="OkButton"     Content="OK"     IsDefault="True" Width="100" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"  Width="100" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
