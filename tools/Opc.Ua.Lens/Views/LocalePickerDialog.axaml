<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Views.LocalePickerDialog"
        Title="Preferred locales"
        Width="460" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">

    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" TextWrapping="Wrap"
               Text="Ordered list of preferred locale identifiers. Sent on connect and via ChangePreferredLocales for the active session." />

    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
      <TextBox x:Name="NewLocaleBox" Width="160"
               PlaceholderText="e.g. en-US" />
      <Button x:Name="AddButton" Content="Add" Width="80" />
    </StackPanel>

    <ListBox Grid.Row="2" Grid.Column="0" x:Name="LocaleList"
             Margin="0,8,8,0"
             Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextPrimary}" />

    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical"
                Margin="0,8,0,0" Spacing="6" VerticalAlignment="Top">
      <Button x:Name="UpButton"     Content="↑" Width="44" />
      <Button x:Name="DownButton"   Content="↓" Width="44" />
      <Button x:Name="RemoveButton" Content="✕" Width="44" />
    </StackPanel>

    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="6">
      <Button x:Name="ApplyButton" Content="Apply"
              IsDefault="True" Width="120"
              Background="{DynamicResource AccentBlue}" Foreground="{DynamicResource AppBg}" FontWeight="SemiBold" />
      <Button x:Name="CancelButton" Content="Close" IsCancel="True" Width="100" />
    </StackPanel>
  </Grid>
</Window>
