<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UaLens.Views.SubscriptionSettingsDialog"
        Title="Subscription parameters"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <Grid ColumnDefinitions="*,140" Margin="0,0,0,12">
      <TextBlock Text="Publishing interval (ms)" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="PubMs" />
    </Grid>
    <CheckBox Grid.Row="1" x:Name="PublishingEnabled" Content="Publishing enabled" Margin="0,0,0,12" />
    <Expander Grid.Row="2" Header="Advanced subscription settings" IsExpanded="False" VerticalAlignment="Top">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,130" Margin="0,10">
        <TextBlock Text="Keep-alive count" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="KeepAlive" />
        <TextBlock Grid.Row="1" Text="Lifetime count" VerticalAlignment="Center" Margin="0,10,0,0" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="Lifetime" Margin="0,10,0,0" />
        <TextBlock Grid.Row="2" Text="Maximum notifications / publish" VerticalAlignment="Center" Margin="0,10,0,0" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxNotifs" Margin="0,10,0,0" />
        <TextBlock Grid.Row="3" Text="Priority (0-255)" VerticalAlignment="Center" Margin="0,10,0,0" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="Priority" Margin="0,10,0,0" />
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Classes="caption" Margin="0,12,0,0">
          <TextBlock.Text>
            The server revises unsupported values. Publish worker/request limits belong to the
            connection settings, not this document.
          </TextBlock.Text>
        </TextBlock>
      </Grid>
    </Expander>
    <TextBlock Grid.Row="3" x:Name="ValidationError" TextWrapping="Wrap"
               Foreground="{DynamicResource AccentRed}" Margin="0,8,0,8" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="OkButton" Content="Apply" Classes="primary" IsDefault="True" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
