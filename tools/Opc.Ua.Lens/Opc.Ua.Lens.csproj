<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(CustomTestTarget)' == ''">net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CustomTestTarget)' != ''">$(CustomTestTarget)</TargetFrameworks>
    <RestrictForLegacyTfm>true</RestrictForLegacyTfm>
    <AssemblyName>UaLens</AssemblyName>
    <OutputType>Exe</OutputType>
    <PackageId>OPCFoundation.NetStandard.Opc.Ua.Lens</PackageId>
    <Company>OPC Foundation</Company>
    <Description>UaLens — multi-tab Avalonia desktop client for OPC UA.</Description>
    <PackageProjectUrl>https://github.com/OPCFoundation/UA-.NETStandard</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <PackageTags>opc-ua;opcua;client;avalonia;dotnet-tool</PackageTags>
    <Copyright>Copyright © 2025 OPC Foundation, Inc</Copyright>
    <RootNamespace>UaLens</RootNamespace>
    <Nullable>enable</Nullable>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <LangVersion>14.0</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <UseAvalonia>true</UseAvalonia>
    <NoWarn>$(NoWarn);CS0618;EXTOBS0001;CA1812</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PublishAot Condition="'$(PublishAotEnabled)' != 'false'">true</PublishAot>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Lock the nullable migration in: any future regression that
         introduces a CS86xx becomes a build break instead of a silent
         warning. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <!-- The tool package uses net10.0; net8/net9 remain desktop build targets.
         Select CustomTestTarget=net10.0 for restore/build/pack so stale framework
         dependency groups cannot leak into the tool package. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ualens</ToolCommandName>
    <PackageType>DotnetTool</PackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (PNG for window/taskbar via Avalonia; ICO consumed by
         <ApplicationIcon> for the Windows .exe resource). -->
    <AvaloniaResource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- UaLens ships its own package-local NugetREADME.md (packed at the
         package root) so the nuget.org landing page describes UaLens. -->
    <None Include="NugetREADME.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="ScottPlot.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.ResourceMonitoring" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Castle's proxy assembly has its own signing key, not the OPC Foundation key. -->
    <_ProxyKey>0024000004800000940000000602000000240000525341310004000001000100</_ProxyKey>
    <_ProxyKey>$(_ProxyKey)c547cac37abd99c8db225ef2f6c8a3602f3b3606cc9891605d02baa56104f4cf</_ProxyKey>
    <_ProxyKey>$(_ProxyKey)c0734aa39b93bf7852f7d9266654753cc297e7d2edfe0bac1cdcf9f717241550</_ProxyKey>
    <_ProxyKey>$(_ProxyKey)e0a7b191195b7667bb4f64bcb8e2121380fd1d9d46ad2d92d2d15605093924</_ProxyKey>
    <_ProxyKey>$(_ProxyKey)cceaf74c4861eff62abf69b9291ed0a340e113be11e6a7d3113e92484cf7045cc7</_ProxyKey>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Opc.Ua.Lens.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="$(_ProxyKey)"
                        Condition="'$(SignAssembly)' == 'true'" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Condition="'$(SignAssembly)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Ua.Core\Opc.Ua.Core.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.AI.Client\Opc.Ua.AI.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Robotics.Client\Opc.Ua.Robotics.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Vision.Client\Opc.Ua.Vision.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.OpenUsd.Client\Opc.Ua.OpenUsd.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Di.Client\Opc.Ua.Di.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.ISA95.Client\Opc.Ua.ISA95.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.WotCon.Client\Opc.Ua.WotCon.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.XRegistry.Client\Opc.Ua.XRegistry.Client.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.PubSub\Opc.Ua.PubSub.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.PubSub.Udp\Opc.Ua.PubSub.Udp.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.PubSub.Mqtt\Opc.Ua.PubSub.Mqtt.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.PubSub.Kafka\Opc.Ua.PubSub.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.PubSub.Eth\Opc.Ua.PubSub.Eth.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.PubSub.Adapter\Opc.Ua.PubSub.Adapter.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Gds.Client\Opc.Ua.Gds.Client.csproj" />
  </ItemGroup>
</Project>
