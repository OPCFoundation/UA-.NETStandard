<!-- Light theme — white / light-gray backgrounds, dark text. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UaLens.Themes.LightTheme">
  <SolidColorBrush x:Key="PanelBg"             Color="#FFFFFF" />
  <SolidColorBrush x:Key="AppBg"               Color="#F3F4F6" />
  <SolidColorBrush x:Key="SurfaceBg"           Color="#F8F9FB" />
  <SolidColorBrush x:Key="ToolbarBg"           Color="#EEF1F5" />
  <SolidColorBrush x:Key="HighlightBg"         Color="#E7EFFF" />

  <SolidColorBrush x:Key="PanelBorder"         Color="#D7DCE4" />
  <SolidColorBrush x:Key="SeparatorBrush"      Color="#DDE2E9" />

  <SolidColorBrush x:Key="TextDim"             Color="#5B6574" />
  <SolidColorBrush x:Key="TextSecondary"       Color="#475366" />
  <SolidColorBrush x:Key="TextSecondaryAlt"    Color="#354257" />
  <SolidColorBrush x:Key="TextPrimary"         Color="#1B2430" />
  <SolidColorBrush x:Key="TextOnAccent"        Color="#FFFFFF" />

  <SolidColorBrush x:Key="AccentBlue"          Color="#1D4ED8" />
  <SolidColorBrush x:Key="AccentCyan"          Color="#0E7490" />
  <SolidColorBrush x:Key="AccentGreen"         Color="#166534" />
  <SolidColorBrush x:Key="AccentYellow"        Color="#854D0E" />
  <SolidColorBrush x:Key="AccentYellowLight"   Color="#854D0E" />
  <SolidColorBrush x:Key="AccentRed"           Color="#B91C1C" />
  <SolidColorBrush x:Key="AccentRedLight"      Color="#B91C1C" />
  <SolidColorBrush x:Key="AccentPurple"        Color="#6D28D9" />
  <SolidColorBrush x:Key="SuccessText"         Color="#166534" />
  <SolidColorBrush x:Key="WarningText"         Color="#854D0E" />
  <SolidColorBrush x:Key="ErrorText"           Color="#B91C1C" />
  <SolidColorBrush x:Key="InfoText"            Color="#0E7490" />
  <SolidColorBrush x:Key="AccentYellowBorder"  Color="#FEF3C7" />
</ResourceDictionary>
