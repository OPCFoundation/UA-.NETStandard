<!-- Dark Standard theme — neutral grays (no navy tint). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UaLens.Themes.DarkStandardTheme">
  <SolidColorBrush x:Key="PanelBg"             Color="#1D1F23" />
  <SolidColorBrush x:Key="AppBg"               Color="#141619" />
  <SolidColorBrush x:Key="SurfaceBg"           Color="#181A1E" />
  <SolidColorBrush x:Key="ToolbarBg"           Color="#292D33" />
  <SolidColorBrush x:Key="HighlightBg"         Color="#29384F" />

  <SolidColorBrush x:Key="PanelBorder"         Color="#3A404A" />
  <SolidColorBrush x:Key="SeparatorBrush"      Color="#333943" />

  <SolidColorBrush x:Key="TextDim"             Color="#ADB8C8" />
  <SolidColorBrush x:Key="TextSecondary"       Color="#B0B9C6" />
  <SolidColorBrush x:Key="TextSecondaryAlt"    Color="#D1D7E1" />
  <SolidColorBrush x:Key="TextPrimary"         Color="#F1F3F7" />
  <SolidColorBrush x:Key="TextOnAccent"        Color="#101826" />

  <SolidColorBrush x:Key="AccentBlue"          Color="#8FB4FF" />
  <SolidColorBrush x:Key="AccentCyan"          Color="#67E8F9" />
  <SolidColorBrush x:Key="AccentGreen"         Color="#4ADE80" />
  <SolidColorBrush x:Key="AccentYellow"        Color="#FACC15" />
  <SolidColorBrush x:Key="AccentYellowLight"   Color="#FACC15" />
  <SolidColorBrush x:Key="AccentRed"           Color="#FCA5A5" />
  <SolidColorBrush x:Key="AccentRedLight"      Color="#FCA5A5" />
  <SolidColorBrush x:Key="AccentPurple"        Color="#C4B5FD" />
  <SolidColorBrush x:Key="SuccessText"         Color="#4ADE80" />
  <SolidColorBrush x:Key="WarningText"         Color="#FACC15" />
  <SolidColorBrush x:Key="ErrorText"           Color="#FCA5A5" />
  <SolidColorBrush x:Key="InfoText"            Color="#67E8F9" />
  <SolidColorBrush x:Key="AccentYellowBorder"  Color="#3D3D1C" />
</ResourceDictionary>
