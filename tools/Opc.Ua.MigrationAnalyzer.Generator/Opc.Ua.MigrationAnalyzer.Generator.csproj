<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Visual Studio 2026 build of the OPC UA migration source generator, and the
    variant the repository's own test project references. The sibling
    Opc.Ua.MigrationAnalyzer.Generator.Roslyn4_8 project produces the Visual
    Studio 2022 payload from the same sources.
  -->
  <!-- Already imported by Directory.Packages.props; the condition keeps this project self-contained. -->
  <Import Project="..\..\roslyn.props" Condition="'$(RoslynApiVersionVS2026)' == ''" />
  <PropertyGroup>
    <RoslynApiVersion>$(RoslynApiVersionVS2026)</RoslynApiVersion>
    <!-- Non-packable on its own; consumed by the parent Opc.Ua.MigrationAnalyzer nuspec by path. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="Opc.Ua.MigrationAnalyzer.Generator.Sources.targets" />
</Project>
